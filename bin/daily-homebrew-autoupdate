# ***

# DEVEL/2026-01-24: The easy way to test:
__CPYST__='
  env -i HOME="$HOME" LOGNAME="$LOGNAME" bash --noprofile --norc
  ~/.depoxy/ambers/bin/daily-homebrew-autoupdate
'

# ALTLY/2025-11-02: Force an Anacron run (e.g., to test environment
# prepared correctly, vs. running from your shell which can mask an
# underprepared cron environment):
__CPYST__="
  mv ~/.anacron/daily ~/.anacron/daily-OFF
  mkdir ~/.anacron/daily
  ln -sfn ~/.depoxy/ambers/bin/daily-homebrew-autoupdate ~/.anacron/daily/
  date -d'1 day ago' '+%Y%m%d' > ~/.anacron/spool/cron.daily
  # From one terminal (& wait ~5m for output):
  tail -F ~/.local/state/depoxy/log/homebrew-autoupdate.out
  # From another terminal:
  # - ALERT: Per ~/.anacron/anacrontab, anacron delays 5 minutes before
  #   running the daily scripts, though I'm not sure how often it checks
  #   the cron.daily date. It seems to take up to 10 minutes for the job
  #   to finally run:
  /usr/sbin/anacron -s -t ~/.anacron/anacrontab -S ~/.anacron/spool
  # And then afterwards:
  rm ~/.anacron/daily
  mv ~/.anacron/daily-OFF ~/.anacron/daily
"

# ***

# CALSO: Because homebrew-autoupdate is macOS-specific (because LaunchAgents):
#   ~/.kit/mOS/homebrew-autoupdate
# - CXREF:
#   ~/.depoxy/ambers/home/.kit/mOS/homebrew-autoupdate/homebrew-autoupdate.sh

# ***

# THOTS: On where to keep the log:
# - I see two obvious log locations:
#   - ~/.var/log, with obeisance to Linux's /var/log.
#   - ~/.local/state/{app}/log, with deference to XDG.
# - Note that ~/.var is not a standard path.
#   - Flatpak uses it, e.g., you'll find Flatpak GIMP user
#     cache, config, etc., under ~/.var/app/org.gimp.GIMP/.
# - On the other hand, the XDG Specification suggests logs
#   are stored under XDG_STATE_HOME (~/.local/state):
#     https://specifications.freedesktop.org/basedir-spec/latest/#variables
#   So perhaps thereunder is more sensible than ~/.var/log.
#   - On the other hand, /var/log is for more general logs,
#     and, even though this is a DepoXy/bin script, the log
#     is in regards to Homebrew, which is more OS-wide, so
#     using ~/.var/log also seems perfectly reasonable.
#   - Nonetheless, let's use ~/.local/state/depoxy, so it's
#     obvious which project manages the files therebelow.
# - CALSO: macOS homebrew-autoupdate log is maintained at:
#   ~/Library/Logs/com.github.domt4.homebrew-autoupdate/com.github.domt4.homebrew-autoupdate.out
# - CXREF:
#   ~/.local/state/depoxy/log/homebrew-autoupdate.out
DXY_STATE_HOME="${DXY_STATE_HOME:-${XDG_STATE_HOME:-${HOME}/.local/state}/depoxy}"
DXY_HOMEBREW_AUTOUPDATE_LOG="${DXY_HOMEBREW_AUTOUPDATE_LOG:-${DXY_STATE_HOME}/log/homebrew-autoupdate.out}"
# See comment below re: logrotate usage.
DXY_LOGROTATE_STATUS="${DXY_LOGROTATE_STATUS:-${DXY_STATE_HOME}/lib/logrotate/status}"

# COPYD: This email to-address uses the same format that our macOS script uses:
#   ~/.depoxy/ambers/home/.kit/mOS/homebrew-autoupdate/homebrew-autoupdate.sh
# - REFER: The email from-address that logrotate uses is the user's Full Name:
#     getent passwd $(id -un) | cut -d ':' -f 5 | cut -d ',' -f 1
#   And, if you use an external SMTP server, the address from the Postfix config:
#     sudo cat sasl_passwd | sed 's/.* \(.*\):.*/\1/'
#   formatted as "Full Name <from@host>".
SEND_EMAIL_TO_FRIENDLY="$(id -un)@$(hostname)"

# ***

source_deps() {
  ensure_deps_brew

  ensure_deps_mr
}

# Ensures `brew` on path, and shell prepared.
ensure_deps_brew() {
  . "$(dirname -- "$(realpath -- "$0")")/../core/brewskies.sh"
  _depoxy_infuse_brew_shellenv
}

ensure_deps_mr() {
  if ! command -v mr > /dev/null; then
    export PATH="${HOME}/.local/bin:${PATH}"
  fi

  if ! command -v mr > /dev/null; then
    >&2 echo "ERROR: Cannot find \`mr\`"

    exit_1
  fi

  # Sets OHMYREPOS_LIB, etc.
  # CXREF: ~/.depoxy/ambers/core/path_vars.sh
  . "$(dirname -- "$(realpath -- "$0")")/../core/path_vars.sh"
}

# ***

brew_upgrade_capture_log() {
  brew_upgrade_log_annotated 2>&1 \
    | log_and_maybe_echo
}

log_and_maybe_echo() {
  if ${inhibit_echo}; then
    # When run by (ana)cron, log only (so email not sent).
    cat >> "${DXY_HOMEBREW_AUTOUPDATE_LOG}"
  else
    # When run by user, log and echo.
    tee -a "${DXY_HOMEBREW_AUTOUPDATE_LOG}"
  fi
}

# ***

# We don't necessarily *need* to run 'infuse' (at least I don't
# think so), but macOS homebrew-autoupdate (DepoXy's fork) does;
# and it ensures we proactively catch any issues. (We might also
# need to do this, if, e.g., we need to recreate ~/.local/bin
# symlinks... not sure; I just want this exercised daily).
omr_depoxy_infuse() {
  local stderr_file
  stderr_file="$(mktemp -t "depoxy_daily_homebrew--XXXX")"

  (
    echo "\$ mr -d / infuse >/dev/null"
    mr -d / infuse > /dev/null
  ) 2> "${stderr_file}" \
    | log_and_maybe_echo

  # Filter captured stderr, filtering known output, and
  # leaking unmatched output, which cron'll email to us.
  # - Ignore broken symlinks that ctags complains about,
  #   e.g.,
  #     ctags: Warning: cannot open source file "Users/user/foo/bar/baz" : No such file or directory
  cat "${stderr_file}" \
    | >&2 grep -v "^ctags: Warning: cannot open source file" \
    || true

  command rm -- "${stderr_file}"
}

# ***

# REFER: man logrotate
# - DEVEL: Use -d/--debug to verify config file.
# - DEVEL: Use -v/--verbose for step-by-step progress messaging.
# - SAVVY: Use -s/--state to specify user state file, otherwise:
#     error: error opening state file /var/lib/logrotate/status: Permission denied
#   - logrotate flock's state file to avoid parallel runnings, and to record latest
#     operation, e.g.,:
#       logrotate state -- version 2
#       "/home/user/.local/state/depoxy/log/homebrew-autoupdate.out" 2025-10-26-11:5:24
#   - It also accepts `--state /dev/null`, in which case a lock file is not used.
#
DXY_LOGROTATE_VERBOSE="${DXY_LOGROTATE_VERBOSE}"
# DEVEL: Uncomment (or set externally) for verbose logrotate reporting:
#  DXY_LOGROTATE_VERBOSE="--verbose"

# DEVEL: To test logrotate, create sized log file:
#   # Create 24K file of null bytes:
#   #   dd if=/dev/zero of="${DXY_HOMEBREW_AUTOUPDATE_LOG}" bs=1K count=24
#   # Create 24K file of random ASCII text:
#   base64 /dev/urandom | head -c 24576 > "${DXY_HOMEBREW_AUTOUPDATE_LOG}"
#   # Or without newlines every 76 characters:
#   #  base64 -w 0 /dev/urandom | head -c 24576 > "${DXY_HOMEBREW_AUTOUPDATE_LOG}"
# Set `size 1k` config setting, and exit at end of this func.
DXY_LOGROTATE_SIZE="${DXY_LOGROTATE_SIZE:-10M}"
# DEVEL: Uncomment to test logrotate using `base64` random date (from above CPYST):
#  DXY_LOGROTATE_SIZE="1k"

DXY_LOGROTATE_COUNT="${DXY_LOGROTATE_COUNT:-5}"

# SAVVY: Cannot use <() process substitution.
# - E.g., trying either this:
#     logrotate --verbose <(
#       cat << EOF
#     compress
#     ...
#     EOF
#     )
#   Or this:
#     cat << EOF | logrotate --verbose /dev/stdin
#     compress
#     ...
#     EOF
#     }
#   Does not work:
#     Ignoring /dev/stdin because it's not a regular file.
#     error: error opening state file /var/lib/logrotate/status: Permission denied
# - So we'll use a temp file instead.

brew_upgrade_logrotate() {
  local log_path="$1"

  mkdir -p -- "$(dirname -- "${log_path}")"
  mkdir -p -- "$(dirname -- "${DXY_LOGROTATE_STATUS}")"

  local config_file
  config_file=$(mktemp --suffix='.out' --tmpdir 'DXY-Daily-Homebrew-Autoupdate-Logrotate-XXXXXXX')

  cat << EOF > "${config_file}"
compress

${log_path} {
  # Limit to 5 max old log files.
  rotate ${DXY_LOGROTATE_COUNT}
  # Email old log when "log is rotated out of existence".
  mail ${SEND_EMAIL_TO_FRIENDLY}
  # MAYBE: Rotate on fixed schedule instead of size, e.g.:
  #  yearly
  size ${DXY_LOGROTATE_SIZE}
  missingok
  # ALTLY: nocompress
  compress
}
EOF

  # REFER: See comments above re: `man logrotate` highlights.
  logrotate --state "${DXY_LOGROTATE_STATUS}" ${DXY_LOGROTATE_VERBOSE} "${config_file}"

  command rm -- "${config_file}"
}

# ***

brew_upgrade_log_annotated() {
  print_header

  print_command "brew update"
  brew update

  # ALTLY: We could instead upgrade formulae and casks separately,
  # like macOS homebrew-autoupdate does, i.e.:
  #   # CXREF: ~/.kit/mOS/homebrew-autoupdate/lib/autoupdate/start.rb @ 61
  #   print_command "brew upgrade --formula -v"
  #   brew upgrade --formula -v
  #   # CXREF: ~/.kit/mOS/homebrew-autoupdate/lib/autoupdate/start.rb @ 75
  #   print_command "brew upgrade --cask -v"
  #   brew upgrade --cask -v

  print_command "brew upgrade"
  brew upgrade

  print_command "brew cleanup"
  brew cleanup

  print_footer
}

# ***

print_header() {
  date "+# %a %Y-%m-%d %H:%M"
}

print_command() {
  local cmd="$1"

  echo "\$ ${cmd}"
}

print_footer() {
  echo
}

# ***

# This script likely runs on macOS (though untested), but we use
# the mainstream LaunchAgests-specific Homebrew/homebrew-autoupdate
# project to keep macOS Homebrew formulae and casks up-to-date.
insist_os_is_linux() {
  if os_is_linux; then

    return
  fi

  >&2 echo "ERROR: Please run from Linux (not meant for $(uname))"

  exit 1
}

os_is_linux() {
  [ "$(uname)" = 'Linux' ]
}

isa_tty() {
  ([ -t 0 ] && [ -t 1 ])
}

# ***

main() {
  set -e

  insist_os_is_linux

  source_deps

  brew_upgrade_logrotate "${DXY_HOMEBREW_AUTOUPDATE_LOG}"

  local inhibit_echo=false
  isa_tty || inhibit_echo=true

  brew_upgrade_capture_log

  omr_depoxy_infuse
}

# Only run when executed; no-op when sourced.
if [ -n "${BASH_SOURCE}" ] && [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
fi
