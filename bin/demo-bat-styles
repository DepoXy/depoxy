main() {
  set -e

  local ambers_path="${DEPOXYDIR_BASE_FULL:-${HOME}/.depoxy}/ambers"
  local ambers_root="${DEPOXYAMBERS_DIR:-${ambers_path}}"

  . "${ambers_root}/bin/demo-terminal-output-styles"
  demo_bat_styles__automated "$@"
}

main "$@"
