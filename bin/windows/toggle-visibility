toggle_window_focus() {
  local win_before

  # E.g., '65012405'
  win_before="$(get_focused_window_id "${de_name}")" ||
    true

  if ! raise_window "${de_name}" "$@"; then

    return 1
  fi

  # TRACK/2024-12-01 04:54: If the frontmost window is not the one
  # being raised, but it's minimized when you run this command, you
  # might need to hold off for a split second for `wmctrl -a` to
  # finish raising the intended target.
  # - E.g.:
  #
  #   sleep 0.13

  local win_after
  win_after="$(get_focused_window_id "${de_name}")"

  if [ "${win_before}" = "${win_after}" ]; then
    # Window was already topmost, so minimize (iconify) it.
    minimize_window "${de_name}" "${win_before}"
  fi
}

# ***

# REFER: Depends on GNOME Shell Extension:
#   https://extensions.gnome.org/extension/4724/window-calls/
#   https://github.com/ickyicky/window-calls
get_focused_window_id() {
  local de_name="$1"

  if [ "${de_name}" = "GNOME" ]; then
    get_focused_window_id_Wayland
  else
    get_focused_window_id_XWindow
  fi
}

get_focused_window_id_Wayland() {
  if ! gdbus call --session --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/Windows \
    --method org.gnome.Shell.Extensions.Windows.List |
    head -c -4 | tail -c +3 |
    jq '.[] | select(.focus == true) | .id' \
    ; then

    alert_missing_gnome_extension_window_calls

    return 1
  fi
}

get_focused_window_id_XWindow() {
  xdotool getactivewindow
}

# ***

raise_window() {
  local de_name="$1"
  shift

  if [ "${de_name}" = "GNOME" ]; then
    raise_window_Wayland "$@"
  else
    raise_window_XWindow "$@"
  fi
}

# CXREF: See similar gdbus calls:
#   _hf_print_terminal_window_title_prefixes_Wayland
# ~/.kit/sh/sh-humble-prompt/lib/show-command-name-in-window-title.sh
raise_window_Wayland() {
  local windows_list
  if ! windows_list="$(
    gdbus call --session --dest org.gnome.Shell \
      --object-path /org/gnome/Shell/Extensions/Windows \
      --method org.gnome.Shell.Extensions.Windows.List
  )"; then
    # SAVVY: check_deps makes this path unreachable.
    # E.g. — Error: GDBus.Error:org.freedesktop.DBus.Error.UnknownMethod:
    #   Object does not exist at path “/org/gnome/Shell/Extensions/Foo”
    alert_missing_gnome_extension_window_calls

    return 1
  fi

  # Ignore errors, e.g.,
  #   "Error: GDBus.Error:org.gnome.gjs.JSError.Error: Not found"
  # though that probably only happens when you're debugging, and you're
  # manually replaying windows_list you captured previously.

  local windows_details
  windows_details="$(
    echo "${windows_list}" | head -c -4 | tail -c +3 |
      jq '.[] | .id' |
      xargs -I{} \
        gdbus call --session --dest org.gnome.Shell \
        --object-path /org/gnome/Shell/Extensions/Windows \
        --method org.gnome.Shell.Extensions.Windows.Details \
        {} 2>/dev/null
  )"

  # SAVVY: If window title contains single quotes, gdbus
  # escapes all the double quotes. Or something like that.
  # Which the sed removes.
  #
  # For complex window titles, e.g., if you copy-paste this code
  # into a terminal, and that terminal window title (PS4) is wired
  # to show the command being run, you might see delimited output,
  # e.g., something like this:
  #   ("{\"in_current_workspace\":true,...,\"title\":\"6. windows_details=
  #     \\\"$(echo \\\"${windows_list}\\\" | head -c -4 | tail -c +3
  #     | jq '.[] | .id' | xargs -I{} gdbus call ..., \"canshade\":false}",)
  # As opposed to how `gdbus` prints output if it doesn't need to
  # be escaped, e.g.:
  #   ('{"in_current_workspace":true,...,"title":"4. dconf watch /",
  #     ...,"canshade":false}',)
  # And when the former, delimited text is unpacked by gawk and
  # sed-substituted w/ 's/\\"/"/g' only, you might see, e.g.,:
  #   {"in_current_workspace":true,...,"title":"6. windows_details=
  #     \\"$(echo \\"${windows_list}\\" | head -c -4 | tail -c +3
  #     | jq '.[] | .id' | xargs -I{} gdbus call ...,"canshade":false}
  # But when fed through the jq filter, e.g.,
  #   ... | jq -r '"\(.title)\t\(.id)"'
  # that line causes an error, e.g.,
  #   parse error: Invalid numeric literal at line 9, column 258
  # So in addition to \" -> " also convert \\" -> \" (or at least WFM).

  local title_and_ids
  title_and_ids="$(
    echo "${windows_details}" |
      gawk 'match($0, /\{.*\}/, a) {print a[0]}' |
      sed -e 's/\\"/"/g' -e 's/\\\\"/\\"/g' |
      jq -r '"\(.title)\t\(.id)"'
  )"

  local window_id

  local pattern
  for pattern in "$@"; do
    local title_and_id
    # Use Perl regex, or \t doesn't work (though literal "${pattern}.*	"
    # works, but not "${pattern}.*"$'\t', which is a Bashism anyway).
    title_and_id="$(
      echo "${title_and_ids}" | grep -P -e "${pattern}.*\t" | head -n1
    )"

    if [ -n "${title_and_id}" ]; then
      window_id="$(echo "${title_and_id}" | sed 's/.*\t//')"

      break
    fi
  done

  if [ -n "${window_id}" ]; then
    gdbus call --session --dest org.gnome.Shell \
      --object-path /org/gnome/Shell/Extensions/Windows \
      --method org.gnome.Shell.Extensions.Windows.Activate \
      -- "${window_id}"
  else
    >&2 echo "ALERT: No matching window identified for: $@"

    return 1
  fi
}

raise_window_XWindow() {
  local found_window=false

  local win_title
  for win_title in "$@"; do
    if wmctrl -a "${win_title}"; then
      found_window=true

      break
    fi
  done

  if ! ${found_window}; then

    return 1
  fi
}

# ***

minimize_window() {
  local de_name="$1"
  shift

  if [ "${de_name}" = "GNOME" ]; then
    minimize_window_Wayland "$@"
  else
    minimize_window_XWindow "$@"
  fi
}

minimize_window_Wayland() {
  local window_id="$1"

  # OUTPUTs: ()
  gdbus call --session --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/Windows \
    --method org.gnome.Shell.Extensions.Windows.Minimize \
    -- "${window_id}" >/dev/null
}

minimize_window_XWindow() {
  local window_id="$1"

  xdotool windowminimize "${window_id}"
}

# ***

# COPYD/2025-09-09: From sh-humble-prompt:
#   _hf_probe_desktop_environment
#     https://github.com/DepoXy/sh-humble-prompt#🙇
# - CXREF: For DepoXy users, at:
#   ~/.kit/sh/sh-humble-prompt/lib/show-command-name-in-window-title.sh
_humb_probe_desktop_environment() {
  # Colon-separated list, uppercased.
  local currdes
  currdes="$(echo "${XDG_CURRENT_DESKTOP}" | tr '[:lower:]' '[:upper:]')"

  (
    IFS=:
    for denv in ${currdes}; do
      if [ "${denv}" = "GNOME" ]; then
        echo "GNOME"
      elif [ "${denv}" = "MATE" ]; then
        echo "MATE"
      else

        continue
      fi

      break
    done
  )
}

# ***

os_is_linux() {
  [ "$(uname)" = "Linux" ]
}

check_deps() {
  if ! os_is_linux; then
    >&2 echo "ERROR: This script only runs on Linux"

    return 1
  fi

  if [ "${de_name}" = "GNOME" ]; then
    check_deps_Wayland
  else
    check_deps_XWindow
  fi
}

check_deps_Wayland() {
  if ! [ -d "${HOME}/.local/share/gnome-shell/extensions/window-calls@domandoman.xyz" ]; then
    alert_missing_gnome_extension_window_calls

    return 1
  fi
}

alert_missing_gnome_extension_window_calls() {
  >&2 echo "ERROR: Missing GNOME Extension: window-calls"
  >&2 echo "  https://extensions.gnome.org/extension/4724/window-calls/"
  >&2 echo "  https://github.com/ickyicky/window-calls"
}

check_deps_XWindow() {
  if ! command -v wmctrl >/dev/null; then
    >&2 echo "ERROR: Missing comand \`wmctrl\`"

    return 1
  fi

  if ! command -v xdotool >/dev/null; then
    >&2 echo "ERROR: Missing comand \`xdotool\`"

    return 1
  fi
}

# ***

main() {
  local de_name
  de_name="$(_humb_probe_desktop_environment)"

  if ! check_deps; then

    return 1
  fi

  toggle_window_focus "$@"
}

# ***

_dxybwtv_this_file_name="toggle-visibility"
_dxybwtv_shell_sourced() { [ "$(basename -- "$0")" != "${_dxybwtv_this_file_name}" ]; }

if ! _dxybwtv_shell_sourced; then
  main "$@"
fi

unset -f main
unset -v _dxybwtv_this_file_name
unset -f _dxybwtv_shell_sourced
