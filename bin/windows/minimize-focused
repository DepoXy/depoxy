source_deps() {
  # Load: check_deps, get_focused_window_id, _humb_probe_desktop_environment, minimize_window
  . "${DEPOXYAMBERS_DIR:-${HOME}/.depoxy/ambers}/bin/windows/toggle-visibility"
}

# ***

# On X Windows, effectively runs:
#   xdotool windowminimize $(xdotool getactivewindow)
# On Wayland, calls third-party plugin over gdbus.

minimize_focused() {
  local window_id
  # E.g., '65012405'
  if window_id="$(get_focused_window_id "${de_name}")"; then
    minimize_window "${de_name}" "${window_id}"
  fi
}

# ***

main() {
  source_deps

  local de_name
  de_name="$(_humb_probe_desktop_environment)"

  if ! check_deps; then

    return 1
  fi

  minimize_focused "$@"
}

main "$@"
