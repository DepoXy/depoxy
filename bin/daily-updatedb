# *** Build custom `locate` db — index user home, and keep db private.
#
# - REFER: You'll find extensive notes in the README:
#
#     ~/.depoxy/ambers/home/Library/LaunchAgents/README.rst
#
# - CXREF: See also the `locate` alias:
#
#     ~/.depoxy/ambers/core/locate-db.sh
#
#   - Also the launchd plist:
#
#     ~/.depoxy/ambers/home/Library/LaunchAgents/com.tallybark.daily-updatedb.plist
#
# - SETUP: See the OMR install task:
#
#     mr -d "${DEPOXYAMBERS_DIR:-${HOME}/.depoxy/ambers}" -n install
#
# - DEBUG: If you run this file through (ana)cron or launchd,
#   use a log file to emit messages, or use desktop notifications,
#   e.g.:
#
#     NOTIFY_SILENT=true ~/.depoxy/ambers/bin/notify "Foo bar baz"
#
# - USAGE/DEBUG: Here's how you might develop this script on macOS:
#
__CPYST__USAGE_DEBUG__="
    # @macOS
    rm ~/Library/Logs/com.tallybark.daily-updatedb/daily-updatedb.err
    launchctl kickstart gui/501/com.tallybark.daily-updatedb
    date &&
      while true; do if ! ps aux | grep daily-updated | grep -q bash; then break; fi; done &&
      date &&
      ll ~/Library/Logs/com.tallybark.daily-updatedb/daily-updatedb.err &&
      ll ${LOCATEDB_PATH}
"
#   - You could tail the err file from another shell:
#       tail -F ~/Library/Logs/com.tallybark.daily-updatedb/daily-updatedb.err
#     though you might instead expect not to have any errors, so long as your
#     --localpaths and --prunepaths are tailored appropriately.
#     - If not, you might see "Permission denied" errors, or even
#       "No such file or directory",
#       "Operation not permitted", or
#       "Interrupted system call", though perhaps investigate if you
#       see any of the latter errors, and adjust --localpaths and/or
#       --prunepaths to avoid any errors.

# ***

# USAGE: Call periodically to build the locate.db.
#
# - On Linux, consider scheduling a daily anacron job.
#
# - On macOS, consider using launchd (see link above),
#             otherwise cron (still) works (as of 2024).
#
#   - Note you can edit this file and run the job immediately, e.g.:
#       launchctl kickstart gui/501/com.tallybark.daily-updatedb

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# `eval "$(brew shellenv)"`, essentially.
load_brew() {
  # CXREF: ~/.depoxy/ambers/core/brewskies.sh
  . "${DEPOXYAMBERS_DIR:-${HOME}/.depoxy/ambers}/core/brewskies.sh"

  # SAVVY: Calls `brew`, which calls `sudo --reset-timestamp` (but
  # `daily-updatedb` generally called via anacron or Launch Agent,
  # so probably not a concern; and we need the brew environment
  # when run through one of these non-user-shell vectors).
  _depoxy_infuse_brew_shellenv
}

set_environs() {
  # Load LOCATEDB_PATH, if user set it to an encfs path.
  # - CXREF:
  #   ~/.config/depoxy/321open.cfg
  #   ~/.config/depoxy/depoxyrc
  local client_321opencfg="${XDG_CONFIG_HOME:-${HOME}/.config}/depoxy/321open.cfg"
  if [ -f "${client_321opencfg}" ]; then
    . "${client_321opencfg}"
  fi

  # USYNC: Default path matches `locate` alias path (see: `_wf_locate`):
  #   ~/.depoxy/ambers/core/locate-db.sh
  LOCATEDB_PATH="${LOCATEDB_PATH:-${HOME}/.cache/locate/locate.db}"
}

run_everday_updatedb() {
  # If the updatedb directory does not exist — and is not just
  # a broken symlink — create the directory. (If the directory
  # is a broken symlink, leave it; it might just be unmounted).
  local locatedb_dir="$(dirname -- "${LOCATEDB_PATH}")"

  if [ ! -e "${locatedb_dir}" ] && [ ! -L "${locatedb_dir}" ]; then
    mkdir -p -- "${locatedb_dir}"
  fi

  # If the locatedb_dir path does not exist, it could mean it's
  # stored on an (encrypted) filesystem that is not mounted.
  # - So that this script runs from cron and won't bug you about such
  #   an unimportant matter, silently just do nothing if the storage
  #   path is absent. (The user will realize their db is offline if/
  #   when then try to run `locate`.)
  if [ -d "${locatedb_dir}" ]; then
    generate_locatedb
  fi
}

generate_locatedb() {
  if ! os_is_macos; then
    generate_locatedb_linux
  else
    generate_locatedb_macos
  fi
}

# HSTRY/2024-07-14: I don't quite remember why I added `-l 0`...
# - It was added 2019-04-11 when this script was in a private repo.
# - `-l 0`: "outputs the database entries even if the user running
#            locate(1) could not have read the directory necessary
#            to find out the file described by the database entry."
#   - Perhaps I used to run `sudo updatedb`?
#   - Git commit messages from 2019 suggest `-l 0` is related to either
#     indexing encfs paths, and/or storing the database on an encfs path.
#   - Note that Brew's `gupdatedb` does not have this option.
generate_locatedb_linux() {
  # REFER: /usr/bin/plocate /usr/sbin/updatedb.plocate
  if [ -z "$(command -v plocate)" ]; then
    >&2 echo "ERROR: No \`plocate\`: Please \`apt install plocate\`"

    exit 1
  fi

  LOCATEDB_PATH="${LOCATEDB_PATH}" \
    updatedb \
    -l 0 \
    -o "${LOCATEDB_PATH}"
}

# HSTRY/2024-07-14: The Brew `updatedb` seems... somewhat *obnoxious*,
# or at least the author doesn't totally understand all the nuances.
# - There's the `mdfind` command, which uses the Spotlight database,
#   e.g., `mdfind -name <path>`.
#   - But it doesn't index user home.
#     - And I didn't investigate enough to see how to index user home.
#     - E.g., `mdfind -name ~/<path> won't find it. But if you try a path
#       from the OS, e.g., `mdfind -name bash.1`, then it'll find it.
#   - Nor does `mdfind` index hidden (dot) paths.
# - So we'll use glocate and gupdatedb from `brew install findutils`.
#   - But it's not super obvious about errors.
#     - The most obvious call might be this:
#         $ gupdatedb --localpaths="/" ...
#       But it dies with an error I can't quite suss (the last line):
#         $ gupdatedb --localpaths="/" ...
#         gfind: '/usr/sbin/authserver': Permission denied
#         ...
#         gfind: '/System/Volumes/Data/Library/Caches/com.apple.aned': Operation not permitted
#         gfind: failed to read file names from file system at or below '/': No such file or directory
#       Like, it obviously read *some* files under '/',
#       and it's not like '/' is not a file or directory!
#       - So it feels like the error message is somewhat lacking.
#     - But if you're really precise about *which* directories
#       *not* to include, then it works.
#       - Specifically, including '/System' makes it fail.
#         - And including '/System/Volumes' makes it fail.
#         - And including '/System/Volumes/Data' makes it fail.
#       - Note that '/System/Volumes/Data' is an APFS Firmlink
#         [macOS Catalina introduced Firmlinks, an opaque way
#         to map a path to multiple different paths].
#         - E.g., '/System/Volumes/Data/Users' is same as '/Users'.
#         - REFER: See '/usr/share/firmlinks' for the list of Firmlinks.
#           - Though the author can't quite figure out this file,
#             and Apple is limited on explanation.
#             - E.g., one line says:
#                 /Users Users
#               but it's /System/Volumes/Data/Users at /Users,
#               and not everying in the 'firmlinks' file is from
#               '/System/Volumes/Data'.
#               - *Something magic this way Apple leaves undocumented.*
#           - REFER: https://eclecticlight.co/2023/07/22/how-macos-depends-on-firmlinks/
#             - Among other articles.
#         - REFER/2025-09-06: A few observations that may or may not
#           be Firmlink-related:
#           - Some /Volumes/Data/ paths appear the same as other system paths, e.g.:
#               /Volumes/Data/Library          appears same as /Library, I think
#               /Volumes/Data/opt              appears same as /opt
#               /Volumes/Data/private/etc      appears same as /private/etc
#               /Volumes/Data/private/var      appears same as /private/var
#           - But not all /Volumes/Data/ paths appear same as what you'd expect, e.g.:
#               /Volumes/Data/System/Library   not same as /System/Library
#                 though /Volumes/Data/System empty except for Library/, and
#                 /System is definitely not the same as /Volumes/Data/System
#       - All that "said" (I can't write a line of code without 10 lines
#         of comments, apparently), we'll use crafty `find` sub-commands
#         to weed out these *inappropriate* paths:
#         - Well, the *one* inappropriate path:
#           - Don't index /Sustem/Volumes/Data
#         - But we have to be a little creative to omit it, by indexing
#           / paths individually, and /System paths, and /System/Volumes.
#
# HSTRY/2025-09-06: On further realization, let's limit --localpaths even more.
# - The --localpaths specified below used to be more inclusive (overly so,
#   probably), but then some of author's paths are not indexed (specifically,
#   an encrypted APFS drive that I mount after startup, under /Volumes/,
#   is skipped, even if I add explicitly to --localpaths — although
#   I have another /Volumes/ volume, a DMG image, that *isn't* skipped).
# - Here's the original call, with the overly-inclusive and complicated
#   localpaths setup:
#     # BWARE/2025-09-06: This causes some user /Volumes/* to be skipped.
#     gupdatedb \
#       --localpaths="$(
#         find /* -maxdepth 0 -type d -name System -prune -o -print | tr '\n' ' '
#       ) $(
#         find /System/* -maxdepth 0 -type d -name Volumes -prune -o -print | tr '\n' ' '
#       ) $(
#         find /System/Volumes/* -maxdepth 0 -type d -name Data -prune -o -print -type d | tr '\n' ' '
#       )" \
#       --prunepaths="${HOME}/.password-store ${HOME}/.gnupg ${HOME}/.ssh ${UPDATEDB_PRUNEPATHS}" \
#       --output="${LOCATEDB_PATH}"
# - Note that including only my two volumes indexes them both correctly, e.g.:
#     --localpaths="
#       /Volumes/foo/bar
#       /Volumes/baz/bat" \
#   but then one of those path is not indexed when I try to index most
#   everything under / (using the --localpaths shown above).
# - So, rather than include everything by default and exclude a few things,
#   include fewer paths, and be explicit about them (i.e., don't find-prune,
#   but just list the paths you want).
#   - E.g., do you really need to index /Library ?
# - Note this makes for a much smaller locate.db.
#   - E.g., if I index just $HOME and $UPDATEDB_LOCALPATHS (which specifies
#     my other /Volumes/) localte.db is 28MB (instead of 83MB if
#     I try to index most everything under /).
#   - Though if I include a few other paths from under /, locate.db
#     is 43M (and I see 4 "Permission denied" lines in the err file).
#     - We cam prune these paths explicitly:
#         /Library/Application.Support/Apple/ParentalControls/Users
#         /Library/Application.Support/Apple/AssetCache/Data
#         /Library/OSAnalytics/Preferences/Library
#         /usr/sbin/authserver
# - MAYBE/2025-09-06: Is there utility in indexing top-level paths?
#   - If not, we could remove the following --localpaths:
#       /Applications
#       /bin
#       /Library
#       /opt
#       /sbin
#       /usr
#     - We could also then remove the related --prunepaths paths.

# SAVVY: Note that --prunepaths is used in regex, e.g.:
#   -regex \(^path1$\)\|\(^path2$\)\|...
# - As such, you cannot use partial paths, e.g.:
#     --prunepaths=".Trashes .fseventsd .Spotlight-V100"
#   But you can easily add regex to match any prefix, e.g.:
#     --prunepaths=".*/.Trashes .*/.fseventsd .*/.Spotlight-V100"
#   - And we could technically escape the dot leaders, e.g.:
#       --prunepaths=".*/\\.Trashes .*/\\.fseventsd .*/\\.Spotlight-V100"
#     - But I haven't tested escaped dot leaders....
# - Also be careful with filename spaces, e.g., if you want
#   to ignore `/Volumes/Macintosh HD`, use a dot to match it:
#     --prunepaths="/Volumes/Macintosh.HD"
#   - (I tried `/Volumes/Macintosh\\ HD` but that didn't work for me.)
#
# SAVVY: Default PRUNEFS is "nfs NFS proc", so NFS ignored by default.
# - Just FYI if you wanted to try to include an NFS path.
#   - (You'd probably want to modify PRUNEFS via 321open.cfg.)
#
# SAVVY: Default PRUNEPATHS is "/tmp /usr/tmp /var/tmp /afs".
# - So no need to explicitly prune /tmp, or /private/tmp, etc.

# REFER: See 321open.cfg for UPDATEDB_LOCALPATHS and UPDATEDB_PRUNEPATHS:
#   ~/.depoxy/ambers/archetype/home/.config/depoxy/321open.EVAL.cfg @ 86
#   ~/.depoxy/running/home/.config/depoxy/321open.cfg
generate_locatedb_macos() {
  if [ -z "$(command -v gupdatedb)" ]; then
    >&2 echo "ERROR: No \`gupdatedb\`: Please \`brew install findutils\`"

    exit 1
  fi

  gupdatedb \
    --localpaths="
      /Applications
      /bin
      /Library
      /opt
      /sbin
      /usr
      ${HOME}
      ${UPDATEDB_LOCALPATHS}
      " \
    --prunepaths="
      /Library/Application.Support/Apple/ParentalControls/Users
      /Library/Application.Support/Apple/AssetCache/Data
      /Library/OSAnalytics/Preferences/Library
      /usr/sbin/authserver
      /Library/Caches
      ${HOME}/Library/Caches
      ${HOME}/Library/Containers
      ${HOME}/.gnupg
      ${HOME}/.password-store
      ${HOME}/.ssh
      .*/.Trashes
      .*/.fseventsd
      .*/.Spotlight-V100
      ${UPDATEDB_PRUNEPATHS}
      " \
    --output="${LOCATEDB_PATH}"
}

os_is_macos() {
  [ "$(uname)" = "Darwin" ]
}

# ***

main() {
  set -e

  load_brew

  set_environs

  run_everday_updatedb
}

main "$@"
