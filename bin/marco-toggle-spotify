# USAGE: Call to focus the Spotify application window,
#        useful for, e.g., window manager keybindings.

# Note: Spotify renames the window to "Artist - Song Title" so need to
#   do a little window ID math: get the process ID (PID) using a more
#   exact path, "spotify/spotify" (to distinguish from the associated
#   kdocker task). Then use wmctrl to get the window ID, and then to
#   focus it.

# FIXME/2020-01-07: Figure out how to tell kdocker to restore from tray.
# - For now, only works if Spotify is windowed, and not solely docked.
# 2020-04-28 19:32: Doesn't appear possible via CLI. And it tells you to click:
# "This window is already docked.\nClick on system tray icon to toggle docking."
# https://github.com/user-none/KDocker/blob/master/src/trayitemmanager.cpp#L305

keybinding-focus-spotify () {
  # E.g., '65012405'
  local win_before
  win_before="$(xdotool getactivewindow)"

  local spotify_pid
  spotify_pid=$(ps aux | grep '/usr/share/spotify/spotify %U$' | awk '{print $2}')

  local spotify_win=""
  if [ -n "${spotify_pid}" ]; then
    spotify_win="$(wmctrl -lp | grep "\<${spotify_pid}\>" | awk '{print $1}')"
  fi

  if [ -z "${spotify_win}" ]; then
    # ALERT: Depends on https://github.com/landonb/zoidy_matecocido#🖥️
    # at least for the kdocker icon.
    # OPTNS: kdocker:
    #   -i file   Custom icon path
    #   -m        Keep application window showing (don't hide on dock)
    #   -q        Disable ballooning title changes (quiet)
    # OPTNS: /usr/bin/spotify:
    #   %U        Author does not recall, and cannot find documented.
    /usr/bin/kdocker \
      -i "${HOME}/.config/zoidy_matecocido/icons/spotify-linux-128-CROPPED-118.png" \
      -m \
      -q \
      env \
        BAMF_DESKTOP_FILE_HINT=/usr/share/spotify/spotify.desktop \
        /usr/bin/spotify %U
  else
    wmctrl -i -a "${spotify_win}"

    local win_after
    win_after="$(xdotool getactivewindow)"

    if [ "${win_before}" = "${win_after}" ]; then
      # Window was already topmost, so minimize (iconify) it.
      xdotool windowminimize "${win_before}"
    fi
  fi
}

main () {
  if [ "${BASH_SOURCE[0]}" != "$0" ]; then
    export -f keybinding-focus-spotify
  else
    keybinding-focus-spotify "$@"
  fi
}

main "$@"

