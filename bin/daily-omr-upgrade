#!/usr/bin/env bash
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Landon Bouma <https://tallybark.com/>
# Project: https://github.com/DepoXy/depoxy#🍯
# License: MIT

# ***

# UCASE: Upgrades Neovide nightly:
#   mr -d ~/.kit/nvim/neovide/neovide -n -M upgrade

__CPYST__="
  # Peak at the log file.
  less ~/.local/state/depoxy/log/omr-upgrade.out
"

# ***

# DEVEL: To test from bare shell environment like cron uses, open
# a shell without inheriting the current shell's environment,
# then run this script:
#   env -i HOME="$HOME" LOGNAME="$LOGNAME" bash --noprofile --norc
#   ~/.depoxy/ambers/bin/daily-omr-upgrade

# CXREF: See brew_upgrade_logrotate, related vars., and lots of
# comments (including CPYST for testing via Anacron) defined in
# homebrew-autoupdate script:
#   ~/.depoxy/ambers/bin/daily-homebrew-autoupdate

source_deps() {
  . "$(dirname -- "$(realpath -- "$0")")/daily-homebrew-autoupdate"

  ensure_deps_mr

  # For correctly reporting version:
  export PATH="${GITREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/git}/git-bump-version-tag/bin:${PATH}"

  # Sets OHMYREPOS_LIB, etc.
  # CXREF: ~/.depoxy/ambers/core/path_vars.sh
  . "$(dirname -- "$(realpath -- "$0")")/../core/path_vars.sh"
}

ensure_deps_mr() {
  # So that `mr` found (and so that `mr` itself can find itself, i.e.,
  # `mr -d ~/.kit/nvim/neovide/neovide upgrade` calls `mr` 'merge' action.
  if ! command -v mr > /dev/null; then
    export PATH="${HOME}/.local/bin:${PATH}"
  fi

  if ! command -v mr > /dev/null; then
    >&2 echo "ERROR: Cannot find \`mr\`"

    exit_1
  fi
}

# USYNC: Match same path (same-named var.) as in daily-homebrew-autoupdate.
DXY_STATE_HOME="${DXY_STATE_HOME:-${XDG_STATE_HOME:-${HOME}/.local/state}/depoxy}"

DXY_OMR_UPGRADE_LOG="${DXY_OMR_UPGRADE_LOG:-${DXY_STATE_HOME}/log/omr-upgrade.out}"

# ***

omr_upgrade_capture_log() {
  brew_upgrade_logrotate "${DXY_OMR_UPGRADE_LOG}"

  local inhibit_echo=false
  isa_tty || inhibit_echo=true

  omr_upgrade_log_annotated 2>&1 \
    | if ${inhibit_echo}; then
      # When run by (ana)cron, log only (so email not sent).
      cat >> "${DXY_OMR_UPGRADE_LOG}"
    else
      # When run by user, log and echo.
      tee -a "${DXY_OMR_UPGRADE_LOG}"
    fi
}

# ***

# SAVVY/2025-11-02: There are currently only 3 DepoXy OMR projects that define an 'upgrade' action:
#   [${DOPP_KIT:-${HOME}/.kit}/clang/neovim]
#   [${DOPP_KIT:-${HOME}/.kit}/nvim/neovide/neovide]
#   [${DOPP_KIT:-${HOME}/.kit}/odd/gnome-shell/showmethekey]
# - The homebrew-autoupdate script brew-updates Neovim daily.
# - We don't need to rebuild showmethekey daily.
# - All we care about (currently) is Neovide.
# - If we cared about not being tightly coupled,
#   we'd run through all OMR projects:
#     mr -d / -M upgrade
#   but project traversal is inefficient.
#   - So we'll target explicit projects instead.

omr_upgrade_log_annotated() {
  print_header

  # *** Neovide

  # REFER: LOG_LEVEL, MR_LOG_LEVEL, TIP_LOG_LEVEL (sep. vars. for diff. projects).
  export TIP_LOG_LEVEL=${MR_LOG_LEVEL:-${LOG_LEVEL_WARNING:-30}}
  # Tell git-put-wise not to worry about "unexpected" authors when rebasing
  # (via rebase_tip_merge_release, though merge--ff-only would be fine alt.).
  export PW_OPTION_IGNORE_AUTHOR=true

  print_command "mr -d ~/.kit/nvim/neovide/neovide -n -M upgrade"
  mr -d ${DOPP_KIT:-${HOME}/.kit}/nvim/neovide/neovide -n -M upgrade

  # ***

  print_footer
}

# ***

print_header() {
  date "+# %a %Y-%m-%d %H:%M"
}

print_command() {
  local cmd="$1"

  echo "\$ ${cmd}"
}

print_footer() {
  echo
}

# ***

# This script likely runs on macOS (though untested), but we keep
# Neovide on macOS up-to-date via homebrew-autoupdate, and there
# are no other OMR 'upgrade' actions we care about running daily.
insist_os_is_linux() {
  if os_is_linux; then

    return
  fi

  >&2 echo "ERROR: Please run from Linux (not meant for $(uname))"

  exit 1
}

os_is_linux() {
  [ "$(uname)" = 'Linux' ]
}

isa_tty() {
  ([ -t 0 ] && [ -t 1 ])
}

# ***

main() {
  set -e

  insist_os_is_linux

  source_deps

  omr_upgrade_capture_log
}

# Only run when executed; no-op when sourced.
if [ -n "${BASH_SOURCE}" ] && [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
fi
