#!/usr/bin/env bash
# vim:tw=0:ts=2:sw=2:et:norl:ft=bash
# Author: Landon Bouma <https://tallybark.com/>
# Project: https://github.com/DepoXy/depoxy#🍯
# License: MIT

# UCASE: Emails self reminder if /var/run/reboot-required exists.

# DEVEL:
__CPYST__='
   env -i HOME="$HOME" LOGNAME="$LOGNAME" bash --noprofile --norc
   ~/.depoxy/ambers/bin/daily-alert-reboot-required
'

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

SEND_EMAIL_TO="${SEND_EMAIL_TO:-$(id -un)}"

SEND_EMAIL_TO_FRIENDLY="$(id -un)@$(hostname)"

SEND_EMAIL_FROM="${SEND_EMAIL_FROM:-\"RebootRequired—$(hostname)\" <$(id -un)@$(hostname)>}"

SEND_EMAIL_SUBJECT="The @$(hostname) has a pending reboot"

# SAVVY: macOS Chrome doesn't recog. 'monospace' or "monospace".
SEND_EMAIL_PRE_STYLE="style=\"font-family: Hack, 'DejaVu Sans Mono', monospace; font-size: 13px;\""

# ***

# CXREF:
# ~/.local/state/depoxy/last-reboot-reminder.touchfile
ALERT_REBOOT_LAST_REMINDER="${HOME}/.local/state/depoxy/last-reboot-reminder.touchfile"

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

source_deps() {
  SHCOLORS_OFF=true
  . "${SHOILERPLATE:-${HOME}/.kit/sh}/sh-colors/bin/colors.sh"
  . "${SHOILERPLATE:-${HOME}/.kit/sh}/sh-logger/bin/logger.sh"

  # Load: remind_restart_required
  # CXREF: ~/.depoxy/ambers/core/mindencfs.sh
  #  . "${DEPOXYAMBERS_DIR:-${HOME}/.depoxy/ambers}/core/mindencfs.sh"
  . "$(dirname -- "$(realpath -- "$0")")/../core/mindencfs.sh"

  # Load: date-or-gdate
  # CXREF: ~/.kit/sh/home-fries/lib/date/date-or-gdate.sh
  . "${HOMEFRIES_LIB:-${HOME}/.kit/sh/home-fries/lib}/date/date-or-gdate.sh"

  # Load: uptime-s
  # CXREF: ~/.kit/sh/home-fries/lib/date/uptime-s.sh
  . "${HOMEFRIES_LIB:-${HOME}/.kit/sh/home-fries/lib}/date/uptime-s.sh"
}

email_if_reboot_required() {
  local alert_output
  # Check for /var/run/reboot-required
  # CXREF: ~/.depoxy/ambers/core/mindencfs.sh
  alert_output="$(remind_restart_required)"

  if [ -z "${alert_output}" ]; then
    command rm -f -- "${ALERT_REBOOT_LAST_REMINDER}"

    return 0
  fi

  if ! should_send && ! ${force_print}; then

    return 0
  fi

  if isa_tty; then
    alert_output="$(amend_restart_required "${alert_output}")"
    echo "${alert_output}"
  else
    send_email "${alert_output}"
  fi

  return 1
}

send_email() {
  local alert_output="$1"

  sendmail -oi "${SEND_EMAIL_TO}" \
    << EOF
From: ${SEND_EMAIL_FROM}
To: ${SEND_EMAIL_TO_FRIENDLY}
Subject: ${SEND_EMAIL_SUBJECT}
Content-Type: text/html

<p>
<strong>${SEND_EMAIL_SUBJECT}</strong>
</p>

<p style="color:black">
<pre ${SEND_EMAIL_PRE_STYLE}>${alert_output}</pre>
</p>
EOF
}

# Track once notified so you're not emailing day after day.
# - Note the /tmp cleared on reboot, also maybe after some
#   number of days (e.g., 30).
#   — SPIKE: What service is that?
should_send() {
  local do_send=1

  local uptime_file
  uptime_file="$(mktemp -t "depoxy_reboot_compare--XXXX")"

  rm_uptime_file() {
    command rm -- "${uptime_file}"
  }

  # CXREF: ~/.kit/sh/home-fries/lib/date/uptime-s.sh
  # - ALTLY:
  #   touch -t "$(uptime-s +"%C%y%m%d%H%M.%S")" -- "${uptime_file}"
  touch -d "$(uptime-s "+%C%y-%m-%d %H:%M")" -- "${uptime_file}"

  if [ ! -e "${ALERT_REBOOT_LAST_REMINDER}" ] \
    || [ "${ALERT_REBOOT_LAST_REMINDER}" -ot "${uptime_file}" ] \
    ; then

    do_send=0
  fi

  mkdir -p -- "$(dirname -- "${ALERT_REBOOT_LAST_REMINDER}")"

  touch -- "${ALERT_REBOOT_LAST_REMINDER}"

  rm_uptime_file

  return ${do_send}
}

amend_restart_required() {
  local alert_output="$1"
  echo "${alert_output}

CPYST: Remove touchfile to reset reminder:

  ls -la "${ALERT_REBOOT_LAST_REMINDER}"
  rm "${ALERT_REBOOT_LAST_REMINDER}"
"
}

# ***

os_is_macos() {
  [ "$(uname)" = 'Darwin' ]
}

isa_tty() {
  ([ -t 0 ] && [ -t 1 ])
}

# ***

parse_args() {
  local print_help=false

  while [ "$1" != '' ]; do
    case $1 in
      --help)
        print_help=true
        shift
        ;;
      --force)
        force_print=true
        shift
        ;;
      *)
        >&2 echo "ERROR: Unknown arg: $1"

        exit 1
        ;;
    esac
  done

  if ${print_help}; then
    print_usage

    exit 0
  fi
}

print_usage() {
  >&2 echo "USAGE: $(basename -- "$0") [--force]"
}

main() {
  set -e

  if os_is_macos; then
    >&2 echo "ERROR: Please try again on GNU/Linux"

    return 0
  fi

  source_deps

  local force_print=false
  parse_args "$@"

  email_if_reboot_required \
    || exit 1
}

# Only run when executed; no-op when sourced.
if [ -n "${BASH_SOURCE}" ] && [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
else
  unset -f main
fi
