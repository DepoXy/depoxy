#!/bin/sh

# THANX: *Command-line Lorem Ipsum generator using curl, lipsum.com, and jq*
# https://gist.github.com/candu/33b256292c492f154ade
#
# - By github.com/candu.
#   - Without a license, I'll unjustly assume MIT (and tweak it a titch)
#
# - Beget: https://www.google.com/search?q=lorem+ipsum+curl

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

AMOUNT=5
WHAT=paras
START=false

while getopts ":n:wpbls" opt; do
  case $opt in
    n)
      AMOUNT=$OPTARG
      ;;
    w)
      WHAT=words
      ;;
    p)
      WHAT=paras
      ;;
    b)
      WHAT=bytes
      ;;
    l)
      WHAT=lines
      ;;
    s)
      START=true
      ;;
    *)
      echo "Invalid option: -$OPTARG" >&2
      ;;
  esac
done

curl -s -X POST lipsum.com/feed/json -d "amount=$AMOUNT" -d "what=$WHAT" -d"start=$START" | jq -r '.feed.lipsum'
