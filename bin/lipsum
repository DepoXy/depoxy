# THANX: *Command-line Lorem Ipsum generator using curl, lipsum.com, and jq*
# https://gist.github.com/candu/33b256292c492f154ade
#
# - By github.com/candu.
#   - Without a license, I'll unjustly assume MIT (and tweak it a titch)
#
# - REFER/CALSO:
#   https://www.lipsum.com/
#
# - Beget:
#   https://www.google.com/search?q=lorem+ipsum+curl

# BWARE: The output is not your normal, deterministic Lorem Ipsum.
# - I.e., it's not this:
#     Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
#     tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
#     veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
#     commodo consequat. Duis aute irure dolor in reprehenderit in voluptate
#     velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint
#     occaecat cupidatat non proident, sunt in culpa qui officia deserunt
#     mollit anim id est laborum.
# - E.g.,
#     $ lipsum
#     Maecenas sed ultrices erat. Praesent consequat non lacus at tempus.
#     Nam id ullamcorper nisi. ...

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

DXY_LIPSUM_URL="https://lipsum.com"

print_random_lorem_ipsum() {
  local AMOUNT=5
  local WHAT=paras
  local START=false

  while getopts ":n:wpbls" opt; do
    case $opt in
    n)
      AMOUNT=$OPTARG
      ;;
    w)
      WHAT=words
      ;;
    p)
      WHAT=paras
      ;;
    b)
      WHAT=bytes
      ;;
    l)
      WHAT=lines
      ;;
    s)
      START=true
      ;;
    *)
      echo "Invalid option: -$OPTARG" >&2
      ;;
    esac
  done

  curl -s -X POST "${DXY_LIPSUM_URL}/feed/json" \
    -d "amount=$AMOUNT" \
    -d "what=$WHAT" \
    -d "start=$START" |
    jq -r '.feed.lipsum'
}

# ***

# Note that not setting any args. similar to default output, e.g.:
#
#   print_random_lorem_ipsum_raw() {
#     curl -s -X POST "${DXY_LIPSUM_URL}/feed/json" |
#       jq -r '.feed.lipsum'
#   }

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

main() {
  print_random_lorem_ipsum "$@"
}

main "$@"
