# ISOFF/2024-12-05: CtrlP and CommandT are now disabled
# (they've long since stopped working properly in DepoXy).
# - REFER: For FZF features, see junegunn/fzf.vim, above.
[plugs/wincent/opt/command-t]
lib = remote_set starter https://github.com/wincent/command-t.git
echoInstallHelp = echoInstallHelp 'os_all' 'dxy_all' 'Command-T/cmdT'
isInstalled = test -x "ruby/command-t/ext/command-t/ext.so"
install =
  # ALTLY: :call pathogen#helptags()
  vim -u NONE -c "call pathogen#helptags()" -c q
  #
  # REFER: :help command-t-ruby (previous implementation using Ruby)
  # REFER: :help command-t      (latest   implementation using Lua)
  # - HINT: Use <C-f> in Command-T prompt to clear file list cache.
  which_ruby () {
    # Use Homebrew Ruby for MacVim, so versions match (else won't compile).
    # - Compare shell Ruby versions:
    #     /usr/bin/ruby --version
    #   And:
    #     /opt/homebrew/opt/ruby/bin/ruby --version
    #   To the MacVim version:
    #     :ruby print RUBY_VERSION
    if [ -d "${HOMEBREW_PREFIX}" ]; then
      # I.e., /opt/homebrew/opt/ruby/bin/ruby
      local ruby="${HOMEBREW_PREFIX}/opt/ruby/bin/ruby"
      
      if ! [ -x "${ruby}" ]; then
        >&2 echo "ERROR: Homebrew ruby not found at: ${ruby}"
        
        exit 1
      fi
      printf "%s" "${HOMEBREW_PREFIX}/opt/ruby/bin/ruby"
    else
      printf "%s" "ruby"
    fi
  }
  ruby_make () {
    # Opt-in:
    #   let g:CommandTPreferredImplementation='ruby'
    cd "ruby/command-t/ext/command-t"
    # SAVVY: Vim and System Ruby should match:
    #   $ ruby -e 'puts "#{RUBY_VERSION}-p#{RUBY_PATCHLEVEL}"'
    # Vs.
    #   :ruby puts "#{RUBY_VERSION}-p#{RUBY_PATCHLEVEL}"
    $(which_ruby) extconf.rb
    make
  }
  lua_make () {
    # LATER: See :help command-t-upgrading
    #   for all you need to do to opt-in Lua rewrite.
    cd "lua/wincent/commandt/lib/"
    make
  }
  # - Lua only works on NeoVim and is not feature-complete, and
  #   Ruby implementation is still supported. So sticking with Ruby.
  ( ruby_make )

