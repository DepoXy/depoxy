# REFER: Run Vim without vimrc, run :Helptags, run :quit:
#          -c {command}    Execute {command}
# - SAVVY: Uses pathogen plug's :Helptags command,
#   so must load vimrc, i.e., not: `vim -u NONE ...`
# - SAVVY: Vim complains when not wired for tty, e.g.,
#     Vim: Warning: Output is not to a terminal
#     Vim: Warning: Input is not from a terminal
#   So ignore stderr.
# - SAVVY: If there's an error with this call, we
#   won't know, because it's `echom`'d within Vim
#   and won't be captured on stdout.
setup_vim_generate_helptags () {
  info "Rebuilding Vim helptags: $(font_highlight "call pathogen#helptags()")"

  # TRYNG/2025-01-30: It shouldn't matter if you call Vim or
  # Neovim because either way it builds 'tags' files.
  # - SAVVY: However, `nvim` appears to run the command
  #   and exit, regardless of startup `echom`, whereas
  #   Vim will await user confirmation is there's any
  #   blather during startup.
  DXY_INFUSE_VIM_BUILD_HELPTAGS_VIM=${DXY_INFUSE_VIM_BUILD_HELPTAGS_VIM:-false}

  # SAVVY: Print newline in case Vim prompts on startup...
  # - Note that a Vim startup prompt happens if there are
  #   `echom` messages during startup. Which generally
  #   shouldn't happen, but they might. And if they do,
  #   they could hang the 'infuse' process until the
  #   user interacts with the prompt (which they might not
  #   realize they need to do, because stderr inhibited).
  # ALTLY: `vim -c "Helptags" -c q`, but this call ensures you won't
  # confuse pathogen's :Helptags with Vim's built-in :helptags <dir>
  if ${DXY_INFUSE_VIM_BUILD_HELPTAGS_VIM:-false} || ! command -v nvim >/dev/null; then
    printf "\n" | vim -c ":call pathogen#helptags()" -c q 2> /dev/null
  else
    nvim -c ":call pathogen#helptags()" -c q >/dev/null 2>&1
  fi
}

