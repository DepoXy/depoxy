seed_myrepos_mrconfig_dubs_vim () {
  local before_cd="$(pwd -L)"

  # CXREF: ~/.kit/nvim/.mrconfig — loaded via 'chain = true'
  symlink_overlay_file "nvim-depoxy/mrconfig/_mrconfig" ".mrconfig"

  # ***

  cd -- "${nvim_repos}/nvim-depoxy"

  local ambers_path="${DEPOXYDIR_BASE_FULL:-${HOME}/.depoxy}/ambers"

  # CXREF: ~/.depoxy/ambers/home/.kit/nvim/_mrconfig
  symlink_overlay_file "${ambers_path}/home/.kit/nvim/_mrconfig" "mrconfig/depoxy-mrconfig"

  # USAGE: Optional private DepoXy Client Vim projects.
  # - Place at either ~/.depoxy/running/home/.kit/nvim/_mrconfig-private-nvim
  #   Or at           ~/.depoxy/ambers/home/.kit/nvim/_mrconfig-private-nvim
  local vim_conf_private="home/.kit/nvim/_mrconfig-private-nvim"
  local private_conf
  for private_conf in \
    "${DEPOXYDIR_STINTS_FULL}/${DEPOXY_CLIENT_ID}/${vim_conf_private}" \
    "${ambers_path}/${vim_conf_private}" \
  ; do
    if [ -f "${private_conf}" ]; then
      symlink_overlay_file "${private_conf}" "mrconfig/$(basename -- "${vim_conf_private}")"

      break
    fi
  done

  cd -- "${before_cd}"
}

