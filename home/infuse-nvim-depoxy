source_deps () {
  local omr_lib="${OHMYREPOS_LIB:-${GITREPOSPATH:-${HOME}/.kit/git}/ohmyrepos/lib}"

  local shlogg_dir="${omr_lib}/../deps/sh-logger/bin"

  # HSTRY/2025-01-07: Rather than rely on PATH (you can `. <filename>`
  # and the shell will search PATH for a match) like author's code has
  # mostly done in the past, new approach: The sourced files assume
  # they're sourced from their own directory, so they can find
  # dependencies relative to the current working directory. Also
  # by using the full path when sourcing, we don't have to worry about
  # same-named filename clashes (e.g., avoid sourcing *some other*
  # "logger.sh" on PATH).
  local before_cd="$(pwd -L)"

  cd -- "${shlogg_dir}"
  # Load: warn, etc.
  . "${shlogg_dir}/logger.sh"

  cd -- "${omr_lib}"
  # Load: link_hard
  . "${omr_lib}/link-hard.sh"
  # Load: link_private_exclude
  . "${omr_lib}/link-private-exclude.sh"
  # Load: link_private_ignore, link_private_ignore_
  . "${omr_lib}/link-private-ignore.sh"
  # Load: symlink_*, infuser_prepare, font_highlight
  . "${omr_lib}/overlay-symlink.sh"

  cd -- "${before_cd}"
}

