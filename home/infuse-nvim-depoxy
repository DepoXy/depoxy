main () {
  set -e

  local nvim_repos="${NEOVIM_REPOS:-${DOPP_KIT:-${HOME}/.kit}/nvim}"

  # Unset MR_CONFIG so that the OMR/lib source_deps fcns run.
  MR_CONFIG= source_deps

  if [ "$(basename -- "$0")" = "${SCRIPT_NAME}" ]; then
    LOG_LEVEL=${MR_LOG_LEVEL:-${LOG_LEVEL_VVVERBOSE:-0}}
  else
    LOG_LEVEL=${MR_LOG_LEVEL:-${LOG_LEVEL_TRACE:-10}}
  fi

  # Set MR_REPO, say hello (emit $MR_REPO), and look for --switches.
  infuser_prepare "${nvim_repos}" "$@"

  local before_cd="$(pwd -L)"
  cd -- "${MR_REPO}"

  # ***

  seed_myrepos_mrconfig_dubs_vim

  seed_myrepos_mrinfuse_dubs_vim_plug

  setup_private_git_exclude

  setup_vim_plugs_fdignore

  setup_kit_nvim_git_exclude

  setup_kit_nvim_grep_ignore

  setup_private_grep_ignore

  setup_nvim_depoxy_lua_profile

  setup_nvim_depoxy_lua_specs

  wire_dot_config "nvim"

  wire_dot_config "neovide"

  # ISOFF/2025-02-24: Eh. Seems like a distraction to
  # demo different Neovim configs!
  #
  #  wire_dot_config "nvim-Lazyman"

  # USAGE: Isolated Neovim environments:
  #   NVIM_APPNAME=nvim_dxy nvim
  #   NVIM_APPNAME=nvim_lzy nvim
  wire_dot_config "nvim_depoxy"
  wire_dot_config "nvim_lazyb"

  wire_dot_vimrc_and_autoload

  infuse_this_infuser

  # ***

  # ISOFF/2025-01-31: But keeping for findabilty re: any remaining
  # cmdt_paths/ paths.
  #
  #   setup_private_plug_file_dubs_file_finder

  # ***

  setup_project_plug_vim_depoxy

  setup_project_plug_vim_landonb

  # ***

  # Setup Coc's config.

  setup_private_coc_config

  # ***

  setup_vim_generate_helptags

  # ***

  # ISOFF/2025-02-01: Takes a few seconds, and the directory listing
  # isn't very useful.
  # - Would otherwise populate:
  #   ~/.depoxy/running/home/.kit/nvim/landonb/dubs_project_tray/dubs_cuts/
  #
  #   # It might take a few-ten secs to populate
  #   #   ~/.depoxy/ambers/home/.kit/nvim/landonb/dubs_project_tray/dubs_cuts/
  #   # so call last, to make debugging previous calls quicker.
  #   populate_dubs_cuts_generate
  #   setup_private_plug_file_dubs_project_tray_symlink_dubs_cuts

  # ***

  cd -- "${before_cd}"
}

# Run the infuser iff being executed.
if [ "$(basename -- "$(realpath -- "$0")")" = "${SCRIPT_NAME}" ]; then
  main "$@"
fi

unset -f main

