#  --regex-elm=/^type[ \t]*([A-Z][a-zA-Z0-9'_]*)./\1/t,type/
#  --regex-elm=/^([a-z_][a-zA-Z0-9'_]*).*=/\1/v,function/

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Add extensionless filenames for --langdef=Sh.
# - After changing, verify, e.g.:
#     $ ctags-universal --list-maps | grep "^Sh"
#     Sh       client-* *.sh *.SH *.bsh *.bash *.ksh *.zsh *.ash
#
# INERT/MAYBE/2026-05-31: ALTLY: We could instead rename DepoXy
# (and other project) shell files so they end with .sh extension.
# - But while it might be "tedious" to have to list files herein
#   rather than rename them, I also like being able to name shell
#   files without a file extension... so I think we just need to
#   manage this file, oh well.

# REFER: Here's an example of the different --langmap approaches:
# - Specify as shell arg to ctags invocation (be sure to escape
#   or single-quote globs), e.g.:
#     ctags-groom ... --langmap='Sh:+(client-*)'
# - Use an explicit one-liner herein:
#   --langmap=Sh:+(client-autocommit)(client-include)(client-infuse)(client-infusePostRebase)
# - Or use separate non-globs:
#   --langmap=Sh:+(client-autocommit)
#   --langmap=Sh:+(client-include)
#   --langmap=Sh:+(client-infuse)
#   --langmap=Sh:+(client-infusePostRebase)
# - But easiest approach is glob, when possible, e.g.:
#   --langmap=Sh:+(client-*)

# ~/.depoxy/ambers/mrassets/:
#   client-[autocommit|include|infuse|infusePostRebase]
--langmap=Sh:+(client-*)
# ~/.depoxy/ambers/home/:
#   infuse-config-omr
#   infuse-home-fries
#   infuse-nvim-depoxy
#   infuse-platform-macOS
#   infuse-user-home
--langmap=Sh:+(infuse-*)
# ~/.depoxy/ambers/home/.kit/git/ohmyrepos/bin/:
#   infuse
#   infusePostRebase
#   infuseProjlns
#   updateDeps
--langmap=Sh:+(infuse*)
--langmap=Sh:+(updateDeps)

# DXC files (though does Ctags store var. defs? I don't think so,
# or at least Exub. didn't).
--langmap=Sh:+(depoxyrc)
--langmap=Sh:+(321open.cfg)

--langmap=Sh:+(update-faithful)

# Dunno: Will this work? Ha.
--langmap=Sh:+(*mrconfig*)

