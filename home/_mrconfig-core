# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #
#  Home Fries (robust dotfiles)

[${HOMEFRIES_DIR:-${DOPP_KIT:-${HOME}/.kit}/sh/home-fries}]
order = 202
lib = remote_set publish "https://github.com/landonb/home-fries.git" "home-fries"
infusePostRebase =
  local ambers_path="${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/ambers"
  local infuse_home_fries="${DEPOXYAMBERS_DIR:-${ambers_path}}/home/infuse-home-fries"
  #
  # SAVVY: Note that hard links include scoped commits.
  # - But `updateDeps` still works, and will only commit public commits.
  # - So you could use hard links so you can hack on deps and test
  #   changes immediately, then `updateDeps` to commit changes,
  #   but push a PWIP when finished, then pop the PWIP before
  #   running `updateDeps` again... (which feels tedious, but
  #   there's no alternative other than to not use scoped commits
  #   in deps, or to move those scoped commits to another branch
  #   — and if you know me, you know I like to work *branchlessly*).
  . "${infuse_home_fries}"
  link_hard_dep_shoilerplate
infuse =
  # SKIPD: The 'infuse' action usually calls 'infusePostRebase', but that's
  # redundant here, b/c infuse-home-fries calls link_hard_dep_shoilerplate.
  #
  #  mr -d . -n infusePostRebase
  #
  link_private_exclude "$@"
  link_private_ignore_ "$@"
  #
  local ambers_path="${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/ambers"
  local infuse_home_fries="${DEPOXYAMBERS_DIR:-${ambers_path}}/home/infuse-home-fries"
  #
  # Rely on external infuser scripts for the rest of the setup.
  #
  # CXREF: ~/.depoxy/ambers/home/infuse-home-fries
  LOG_LEVEL=${MR_LOG_LEVEL:-${LOG_LEVEL_TRACE:-10}} \
    "${infuse_home_fries}" "$@"
# CXREF: ~/.depoxy/ambers/home/.kit/git/ohmyrepos/lib/my-deps-manage-shoilerplate.sh @ 44
# - SAVVY: Just FYI: DepoXy ctags work, too, so rather than maintain CXREF line nums.  ↑↑
#          you could use <Ctrl-]> in Vim instead to jump to definition.
# REFER:
#   update_deps_gnome_window_calls
#   update_deps_sh_colors
#   update_deps_sh_humble_prompt
#   update_deps_sh_logger
#   update_deps_sh_pather
#   update_deps_sh_print_nanos_now
#   update_deps_sh_rm_safe
updateDeps = update_deps_shoilerplate
#
skip = mr_exclusive "bash" "sh" "home" "${LOGNAME}" "DXC"
#
# MAYBE/2025-09-07: Move this to ~/.noise 'infuse' task.
lib =
  bhist_file="${HOME}/.bash_history"
  noise_home="${NOISE_DUMP:-${HOME}/.noise}/home"
  noise_hist="${noise_home}/.bash_history"
  relative_hist="$(echo "${noise_hist}" | sed -E "s@^${HOME}/@@")"
  #
  install_bash_history_to_noise() {
    if [ -f "${bhist_file}" ] && [ ! -h "${bhist_file}" ]; then
      if [ -f "${noise_hist}" ]; then
        error "ERROR: Target already exists: ${noise_hist}"
        #
        return 1
      fi
      #
      mkdir -p "${noise_home}"
      command mv -- "${bhist_file}" "${noise_hist}"
      #
      command ln -s -- "${relative_hist}" "${bhist_file}"
    fi
  }
isInstalled = test "$(realpath -- "${bhist_file}")" = "$(realpath -- "${HOME}/${relative_hist}")"
echoInstallHelp = echoInstallHelp 'os_all' 'dxy_all' '~/.noise bash_history'
install = install_bash_history_to_noise

