[${DOPP_KIT:-${HOME}/.kit}/clang/neovim]
lib = remote_set starter https://github.com/neovim/neovim
skip = mr_exclusive_nvim_core
order = 810
echoInstallHelp = echoInstallHelp 'os_all' 'dxy_all'
lib =
  # This lib is on-demand.
  . "${OHMYREPOS_LIB:-${GITREPOSPATH:-${HOME}/.kit/git}/ohmyrepos/lib}/print-homebrew-prefix.sh"
infuse =
  # Redundant, but lots faster than 'install' (though adds a step
  # to the lengthy 'mr -d / infuse' operation, but doesn't add any
  # time, because the bottleneck is load each project's `mr` envi-
  # ronment, and not generally running the action itself.
  ln -sf "$(print_homebrew_prefix)/bin/nvim" "${HOME}/.local/bin/nvim"
isInstalled =
  echo "\$ command -v nvim"
  command -v nvim
install =
  # Assumes user previously ran `brew install neovim` that installs
  # stable release. Here we install the "nightly" build (nightly to
  # us because homebrew-autoupdate will update it, well, every 24h,
  # so not necessarily "nightly", more correctly actually "daily").
  # - CXREF: See original brew-install task:
  #   ~/.kit/mOS/macOS-onboarder/bin/install-homebrew.sh
  brew unlink neovim
  brew install --HEAD neovim
  # E.g., /home/linuxbrew/.linuxbrew/bin/nvim
  ln -sf "$(print_homebrew_prefix)/bin/nvim" "${HOME}/.local/bin/nvim"
  # USYNC: ~/.depoxy/ambers/core/launchvim.sh
  _dxy_kludge_treesitter_lib () {
    local prev="0.24.7/lib/libtree-sitter.0.24.dylib"
    local curr="0.25.2/lib/libtree-sitter.0.24.dylib"
    local base="${HOMEBREW_PREFIX:-/opt/homebrew}/Cellar/tree-sitter"
    #
    if ! [ -e "${curr}" ]; then
      command ln -sfn -- "${base}/${prev}" "${base}/${curr}"
    fi
  }

