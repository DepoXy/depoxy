[${NEOVIM_REPOS:-${DOPP_KIT:-${HOME}/.kit}/nvim}]
order = 361

checkout = mkdir -p -- "${MR_REPO}"
# Not an actual repo
# PRINT: E.g., [DBUG] 2025-02-13 @ 13:56:52   blocklist   /home/user/.kit/nvim
ffssh = OMR_TRAVEL_BLOCKLISTED=true git_merge_ffonly_ssh_mirror "$@"
# AVOID: E.g., mr travel: unknown repository type and no defined travel command for /home/user/.kit/nvim
fetch = true
status = true
travel = true
unpack = true

# USYNC: Because 'chain', use all MR_INCLUDE values from the Vim config:
#   ~/.kit/nvim/.mrconfig
skip = mr_exclusive_nvim_all_tags

# So that nvim OMR config can use relative paths, which makes it more
# easily reusable and maintainable.
chain = true

infuse =
  # SKIPD: Calling infusePostRebase from this infuser is redundant.
  #  mr -d . -n infusePostRebase
  # B/c infuse-nvim-depoxy calls setup_kit_nvim_git_exclude and setup_kit_nvim_grep_ignore.
  #
  local ambers_path="${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/ambers"
  # CXREF: ~/.depoxy/ambers/home/infuse-nvim-depoxy
  local infuse_dubs_vim="${DEPOXYAMBERS_DIR:-${ambers_path}}/home/infuse-nvim-depoxy"
  #
  # CXREF: DXC might override this 'infuse':
  # ~/.depoxy/running/home/.kit/nvim/_mrconfig-include-nvim
  LOG_LEVEL=${MR_LOG_LEVEL:-${LOG_LEVEL_TRACE:-10}} \
    "${infuse_dubs_vim}" "$@"

infusePostRebase =
  # CXREF: ~/.depoxy/ambers/home/infuse-nvim-depoxy
  local ambers_path="${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/ambers"
  local infuse_dubs_vim="${DEPOXYAMBERS_DIR:-${ambers_path}}/home/infuse-nvim-depoxy"
  #
  . "${infuse_dubs_vim}"
  setup_kit_nvim_git_exclude
  setup_kit_nvim_grep_ignore
  #
  link_hard_dep_vim_pack_junegunn_vim_plug
  # link_hard_dep_vim_pack_tpope_vim_pathogen

infuseProjlns =
  OMR_INFUSE_PROJLNS_TOGGLE_OFF=false \
  OMR_INFUSE_PROJLNS_FILES=true \
    infuse_projlns_if_personal_project \
      "landonb/.ignore"

updateDeps = update_deps_vim

# CXREF: The autocommit for ~/.local/share/${NVIM_APPNAME}/site/spell/en.utf-8.add
#                      (née ~/.config/${NVIM_APPNAME}/spell/en.utf-8.add) is within:
#
#   ~/.depoxy/running/.mrconfigs/_mrconfig

# Let user override or extend this [~/.kit/nvim/] config.
include =
  # CXREF: ~/.depoxy/running/home/.kit/nvim/_mrconfig-include-nvim
  cat "${DEPOXYDIR_RUNNING_FULL:-${HOME}/.depoxy/running}/home/.kit/nvim/_mrconfig-include-nvim" \
    2> /dev/null || true

