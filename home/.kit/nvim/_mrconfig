# NSURE: Reset `skip` at end of this file.
# INERT: The (n)vim MR_INCLUDE tags are not really maintained.
lib =
  mr_exclusive_nvim_all_tags() {
    mr_exclusive \
      "aci" "kit" "nvim" "kit-nvim" "DXC" \
      \
      "vim" "dubs-vim" "vim-dubs" "github.com/landonb" \
      "vim-3rdp" "vim-lsp" "vim-private" "vim-plugins" \
      "${LOGNAME}" \
      \
      "vim_active" "!vim_active"
  }
  mr_exclusive_nvim_depoxy() {
    mr_exclusive \
      "aci" "kit" "nvim" "kit-nvim" "DXC" \
      \
      "github.com/landonb" \
      "${LOGNAME}"
  }
  mr_exclusive_nvim_core() { mr_exclusive "kit" "nvim" "kit-nvim" "DXC"; }
