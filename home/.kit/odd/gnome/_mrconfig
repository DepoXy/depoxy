#
# - BEGET: https://www.google.com/search?q=wayland+bring+application+to+front
# https://www.reddit.com/r/gnome/comments/mpwm50/gnomemagicwindow_handy_script_to_bring_a_window/
#
# - CALSO: To send GUI events to windows, use `ydotool`.
#     https://github.com/ReimuNotMoe/ydotool
#       ~/.depoxy/stints/1509/home/.kit/clang/_mrconfig-code-C

# GNMXT: *Run or raise*
#
# CXREF:
# ~/.config/run-or-raise/shortcuts.conf
#
# REFER: https://extensions.gnome.org/extension/1336/run-or-raise/
# - "Launch or focus the window or define custom shortcuts in a text file"
[${DOPP_KIT:-${HOME}/.kit}/odd/gnome-extensions/run-or-raise]
lib = remote_set starter https://github.com/CZ-NIC/run-or-raise.git
infuse =
  os_is_macos \
    || MR_REPO="${HOME}" symlink_mrinfuse_file ".config/run-or-raise/shortcuts.conf"
echoInstallHelp = echoInstallHelp 'os_linux' 'dxy_all'
isInstalled = isInstalled_os_specific
isInstalledLinux = gnome_shellext_is_installed
install = install_os_specific
# CRUMB: gnome_shellext_enable_extension "run-or-raise@edvard.cz"
installLinux = 
  # Recreate shortcuts.conf.
  runorraise_generate_depoxy_ror_shortcuts_conf
  # Ensure ~/.config/run-or-raise/shortcuts.conf symlink.
  mr -d "${MR_REPO}" -n infuse
  # Disable extension if previously enabled,
  # so that shortcuts.conf reloaded.
  gnome_shellext_disable
  # Ensure extension symlink under
  #   ~/.local/share/gnome-shell/extensions/{name@domain}
  # and (re)enable the RoR extension.
  gnome_shellext_symlink_and_enable
lib =
  # CALSO/CXREF: See the 1 other m4_shim user outside deploy-archetype.sh:
  #   tigconfig_generate_depoxy_tig_config
  # ~/.depoxy/ambers/home/infuse-user-home
  #
  tilde_for_home() {
    sed -E "s#^${HOME}(/|$)#~\1#"
  }
  # Generate ~/.depoxy/running/home/.config/run-or-raise/shortcuts.conf
  runorraise_generate_depoxy_ror_shortcuts_conf() {
    local ambers_root="${DEPOXYAMBERS_DIR:-${DEPOXYDIR_BASE_FULL:-${HOME}/.depoxy}/ambers}"
    local archetype_path="${DEPOXYARCHETYPE_DIR:-${ambers_root}/archetype}"
    local active_dxc="${DEPOXYDIR_STINTS_FULL:-${HOME}/.depoxy/stints}/${DEPOXY_CLIENT_ID}"
    #
    local dxc_shortcuts="${active_dxc}/home/.config/run-or-raise/shortcuts-client"
    # USAGE: The user can include their own 'shortcuts-depoxy' to inhibit
    # the one from DepoXy being used.
    # - SAVVY: There's no way for user to override DepoXy's keybindings (if
    #   the 'run-or-raise/shortcuts.conf' config specifies two separate actions
    #   for the same keybindings, RoR runs them both). And there's no way to
    #   *undefine* a binding. So if user wants to disable or redefine a DepoXy
    #   accelerator, currently, they have to exclude the DepoXy config, and
    #   then they have to define all the shortcuts in their client config.
    # - If user's DXC directory contains a 'shortcuts-depoxy' file, we'll
    #   use that file instead of DepoXy's.
    #   - One approach is for the user to copy 'shortcuts-depoxy' to their
    #     client directory, and then to remove, comment-out, or change the
    #     keybindings they care about.
    #   - Another approach is for the user to copy everything they care
    #     about to their own 'shortcuts-client', and then create an empty
    #     'shortcuts-depoxy' file in the DXC directory.
    # Check if user has overridden 'shortcuts-depoxy' with their own copy.
    local dxy_shortcuts="${active_dxc}/home/.config/run-or-raise/shortcuts-depoxy"
    if ! [ -f "${dxy_shortcuts}" ]; then
      # Not overridden. Use 'shortcuts-depoxy' from the DepoXy directory.
      dxy_shortcuts="${ambers_root}/home/.config/run-or-raise/shortcuts-depoxy"
    fi
    #
    # m4_shim uses DEPOXY_CLIENT_FULL/ prefix to format the
    # target path, so creates ${active_dxc}/${gen_shortcuts} aka
    # ~/.depoxy/running/home/.config/run-or-raise/shortcuts.conf
    local gen_shortcuts="home/.config/run-or-raise/shortcuts.conf"
    #
    local bewareness="# ================================================================= #
  
 # BWARE: **This file is GENERATED**
 #
 #   mr -d $(echo "${MR_REPO}" | tilde_for_home) -n install
 #
 # Please edit the source files to make changes:
 #
 #   $(echo "${dxc_shortcuts}" | tilde_for_home)
 #   $(echo "${dxy_shortcuts}" | tilde_for_home)
  
 # ================================================================= #"
    #
    # m4_shim is a wrapper around m4. It uses the environ,
    # DXY_DEPOXY_CLIENT_FULL, to set the target base directory
    # for generated files, which we set appropriately to ensure
    # that the generated file is saved to the client directory,
    # at: ~/.depoxy/running/home/.config/run-or-raise/shortcuts.conf
    # We also specify a number of two-argument key-value pairs
    # that m4_shim uses to set m4 variables used to substitute
    # variables specified in the template file.
    #
  bash -s <<[DEFAULT]
    # CXREF: Load m4_shim and load_and_register_* commands:
    #   ~/.depoxy/ambers/archetype/deploy-archetype.sh
    . "${archetype_path}/deploy-archetype.sh"
    #
    # CXREF: (Safely) Load DXY_* environs (optional) from:
    #   ${archetype_path}/user-settable.envs
    # aka ~/.depoxy/ambers/archetype/user-settable.envs
    # and set m4 --define vars, like DXY_USER_HOME.
    load_and_register_and_prepare_envs
    #
    # DEVEL: Uncomment to debug the precarious filter
    # below that sanitizes 'shortcuts-depoxy' for use
    # as a string argument.
    #   echo -e "\ndxy_shortcuts/1\n"
    #   cat "${dxy_shortcuts}" \
    #     | sed 's/"/\\\\"/g' \
    #     | sed 's/\\\$/\\\\$/g' \
    #     | sed 's/\`/\\\\\`/g'
    #   echo -e "\ndxy_shortcuts/2\n"
    #   #
    #   echo "active_dxc: ${active_dxc}"
    #   echo "dxc_shortcuts: ${dxc_shortcuts}"
    #   echo "gen_shortcuts: ${gen_shortcuts}"
    #   echo "ambers_root: ${ambers_root}"
    #   echo "dxy_shortcuts: ${dxy_shortcuts}"
    #   echo -e "bewareness:\n${bewareness}"
    #
    DXY_DEPOXY_CLIENT_FULL="${active_dxc}" \
      DXY_RUN_LNS_ONLY=false \
      DXY_RUN_MAKE_LNS=false \
      \
      m4_shim "+0" "${dxc_shortcuts}" "${gen_shortcuts}" \
      \
      "DXY_DEPOXYAMBERS_DIR" "${ambers_root}" \
      \
      "DXY_ROR_ALERT_GENERATED_FILE" "${bewareness}" \
      "DXY_ROR_DXY_SHORTCUTS" "\$(
        cat "${dxy_shortcuts}" \
          | sed 's/"/\\\\"/g' \
          | sed 's/\\\$/\\\\$/g' \
          | sed 's/\`/\\\\\`/g')"
 [DEFAULT]
  }
#↓↓↓ So ft=bash stops highlighting the Heredoc.
[DEFAULT]
#↑↑↑ So ft=bash stops highlighting the Heredoc.

