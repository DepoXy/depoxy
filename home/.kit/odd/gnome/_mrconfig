upgradeLinux =
  # Build without apt-install, unless sudo active.
  # - The Neovide OMR 'upgrade' tasks maintains a log file, but that
  #   project moves fast. We don't need to wire a nightly build for
  #   this project, so skip the log file.
  "${install_showmethekey}"

