[${DOPP_KIT:-${HOME}/.kit}/odd/gnome-extensions/gnome-active-window]
lib = remote_set starter https://github.com/vslobodyan/gnome-active-window.git
# ISOFF: I don't think this does anything that windows-calls doesn't do.
skip = true

