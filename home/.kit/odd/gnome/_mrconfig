# *** GNOME Shell Extensions

# **** GNOME Shell Extension `lib`s

# REFER: Determine your GNOME Shell version, e.g.:
#   # E.g., on Debian 12
#   $ gnome-shell --version
#   GNOME Shell 43.9
# - Note that GNOME Shell is managed by the distro, and if your
#   version lags, you'll want to upgrade your distro to upgrade
#   GNOME Shell.
#
# SAVVY: You'll occasionally need to upgrade your distro if you
# need to upgrade GNOME Shell.
# - E.g., circa 2025-09-12, Debian 12 still on GNOME Shell 43,
#   but a log of the extensions below have already been updated
#   to GNOME Shell 48. This broke at least danigm/hide-minimized
#   and adrienverge/gnome-magic-window, and they had to change
#   their implementations. This gives you two choices for
#   installing from sources: checkout old versions of the source
#   code, or upgrade to GNOME Shell 48 by upgrading to Debian 13.

# REFER: Testing GNOME Shell Extensions:
# https://gjs.guide/extensions/development/creating.html#testing-the-extension
#
# REFER: *A Guide to JavaScript for GNOME*
# https://gjs.guide/

lib =
  shell_exts="${HOME}/.local/share/gnome-shell/extensions"
  #
  gnome_shellext_enable_extension() {
    local uuid_name="$1"
    local ext_path="${shell_exts}/${uuid_name}"
    if [ ! -d "${ext_path}" ]; then
      >&2 error "ERROR: Extension directory or symlink missing"
      >&2 error "- Not found at: ${ext_path}"
      #
      exit 1
    fi
    # SAVVY: When first installed, must Log Out GNOME Shell
    # before it can be enabled, or, e.g.:
    #   Extension “name@domain” does not exist
    if gnome-extensions enable "${uuid_name}"; then
      info "GNOME Shell Extension is ON: ${uuid_name}"
    else
      >&2 warn "ALERT: You must Log Out, Log In GNOME Shell to finish"
      >&2 warn "- NTHEN: Run 'install' again to enable each extension"
    fi
    # TSHOOT: "In case it doesn't work, you may need to add your
    # gnome version in metadata.json and reload your session, or
    # debug further."
    # https://github.com/adrienverge/gnome-magic-window#4-debug
    # - E.g., how you might debug gnome-magic-window:
    #   - Alt+F2↵ r↵
    #     gdbus call --session --dest org.gnome.Shell
    #     --object-path /org/gnome/Shell/Extensions/GnomeMagicWindow
    #     --method org.gnome.Shell.Extensions.GnomeMagicWindow.magic_key_pressed
    #     Terminator terminator
  }
  #
  gnome_shellext_disable_extension() {
    local uuid_name="$1"
    local ext_path="${shell_exts}/${uuid_name}"
    if [ ! -d "${ext_path}" ]; then
      >&2 error "ERROR: Extension directory or symlink missing"
      >&2 error "- Not found at: ${ext_path}"
      #
      exit 1
    fi
    #
    if gnome-extensions disable "${uuid_name}"; then
      info "GNOME Shell Extension is OFF: ${uuid_name}"
    else
      >&2 warn "ALERT: Failed to disable extension: ${uuid_name}"
    fi
  }
  #
  gnome_shellext_is_installed() {
    local uuid_name
    uuid_name="$(gnome_shellext_uuid_name)"
    #
    gnome-extensions info "${uuid_name}" > /dev/null 2>&1
  }
  #
  gnome_shellext_uuid_name() {
    cd -- "${MR_REPO}"
    # If no metadata file, probably the core library, e.g.:
    #   ~/.kit/odd/gnome-extensions/gnome-shell-extensions
    if [ ! -f "metadata.json" ]; then
      if [ -z "${OMR_GNOME_EXT_UUID}" ]; then
        >&2 echo "GAFFE: No metadata.json: Please use OMR_GNOME_EXT_UUID"
        #
        exit 1
      else
        uuid_name="${OMR_GNOME_EXT_UUID}"
      fi
    else
      # USYNC: Use the same "uuid" as specified by the manifest.
      local uuid_name
      uuid_name="$(jq -r -s '.[].uuid' "metadata.json")"
      if test "${uuid_name}" = "null"; then
        >&2 echo "ERROR: Could not determine 'uuid' from metadata.json"
        #
        exit 1
      fi
      if [ -n "${OMR_GNOME_EXT_UUID}" ] && [ "${uuid_name}" != "${OMR_GNOME_EXT_UUID}" ]; then
        >&2 echo "ALERT: uuid_name != OMR_GNOME_EXT_UUID: ${uuid_name} != ${OMR_GNOME_EXT_UUID}"
      fi
    fi
    #
    printf "%s" "${uuid_name}"
  }
  #
  gnome_shellext_symlink_and_enable() {
    local uuid_name
    uuid_name="$(gnome_shellext_uuid_name)"
    #
    mkdir -p -- "${shell_exts}"
    cd -- "${shell_exts}"
    symlink_overlay_dir "${MR_REPO}" "${shell_exts}/${uuid_name}"
    #
    gnome_shellext_enable_extension "${uuid_name}"
  }
  #
  gnome_shellext_disable() {
    local uuid_name
    uuid_name="$(gnome_shellext_uuid_name)"
    #
    if [ -d "${shell_exts}/${uuid_name}" ]; then
      gnome_shellext_disable_extension "${uuid_name}"
    fi
  }

