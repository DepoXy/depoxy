lib = remote_set starter https://github.com/adrienverge/gnome-magic-window.git
# ISOFF: We don't need this.
# - Via extension.js, you specify a set of bindings;
#   each binding is a keysequence, a window title to
#   match, and a command to run.
# - When binding pressed, searches for window with
#   matching title and brings it to front.
#   - If already fronted, brings MRU window back to
#     front.
#   - If not found, runs command.
# - By default, binds gnome-terminal to <F12> (which
#   blocks a Neovim abbrev I use regularly). E.g.,
#       const BINDINGS = [
#         {
#           shortcut: 'F12',
#           title: 'Terminator',
#           command: 'terminator'
#         },
#         // more bindings can be added
#       ];
# - This is basically a less featureful (simpler?)
#   run-or-raise.
# - But it's also another example one could reference
#   to learn how to write a GNOME Shell Extension
#   (especially one that intercepts keypresses and
#   looks for matching window titles).
#
#  echoInstallHelp = echoInstallHelp 'os_linux' 'dxy_all'
#  isInstalled = isInstalled_os_specific
#  isInstalledLinux = gnome_shellext_is_installed
#  install = install_os_specific
#  installLinux = gnome_shellext_symlink_and_enable
skip = true

# Not actually an Extension, but related. Just a simple
