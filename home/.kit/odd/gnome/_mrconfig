# COPYD: These 'install' tasks refactored from OMR Neovide 'install'
# (which was the first OMR project to "outsource" the install script
#  using the following approach — a reusable installLinux.sh script
#  located under a ~/.depoxy/ambers/home/.kit subdirectory).
echoInstallHelp = echoInstallHelp 'os_linux' 'dxy_all'
isInstalled = test -x "${HOME}/.local/bin/showmethekey-cli"
install = install_os_specific
lib =
  ambers_path="${DEPOXYDIR_BASE_FULL:-${MR_HOME:-${HOME}}/.depoxy}/ambers"
  dxy_showmethekey_dir="${DEPOXYAMBERS_DIR:-${ambers_path}}/home/.kit/odd/gnome-shell/showmethekey"
  # CXREF: ~/.depoxy/ambers/home/.kit/odd/gnome-shell/showmethekey/installLinux.sh
  install_showmethekey="${dxy_showmethekey_dir}/installLinux.sh"
installLinux =
  # Ensure privileged, otherwise apt-install skipped.
  if ! sudo -n -v 2> /dev/null; then
    echo "Privileges please, for apt-install —"
    sudo -v
  fi
  # Build with apt-install.
  "${install_showmethekey}" --force
