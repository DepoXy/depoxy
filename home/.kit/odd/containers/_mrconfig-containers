# Docker/Kubernetes GUIs/TUIs (mostly installed via Homebrew):
#
#   https://k9scli.io/
#   https://monokle.io/
#   https://k8slens.dev/
#   https://github.com/jesseduffield/lazydocker

# "The lazier way to manage everything docker"
# - SIZED/2024-11-14: 59M (large docs/resources/demo*.gif)
# - USAGE: Demo:
#   - Run Docker Desktop (e.g., `open docker.app`)
#   - Run `lazydocker`
#   - You can also run the example `docker-compose.yml`:
#       docker run --rm -it -v \
#         /var/run/docker.sock:/var/run/docker.sock \
#         -v ~/.kit/odd/containers/lazydocker:/.config/jesseduffield/lazydocker \
#         lazyteam/lazydocker
[${DOPP_KIT:-${HOME}/.kit}/odd/containers/lazydocker]
lib = remote_set starter https://github.com/jesseduffield/lazydocker.git
skip = no_travel

[${DOPP_KIT:-${HOME}/.kit}/odd/containers/monokle/monokle-demo]
lib = remote_set starter https://github.com/kubeshop/monokle-demo.git
skip = no_travel
infuse = link_private_exclude "$@"

