[${DOPP_KIT:-${HOME}/.kit}/rust/alacritty]
lib = remote_set starter https://github.com/alacritty/alacritty.git
# Report *missing🤷* not *fetchfail* and don't die if `ffssh` fails.
lib = export MR_REMOTE_PATH_ABSENCE_EXCUSED=true
checkout =
  if ! skip_unless_macOS; then
    # Stub on macOS
    stub_checkout_directory
  else
    # Checkout on Linux/other
    mr_repo_checkout
  fi
ffssh =
  if skip_unless_macOS; then
    # Sync on Linux/other
    git_merge_ffonly_ssh_mirror "$@"
  else
    # Skip (but report skipped) on macOS
    OMR_TRAVEL_BLOCKLISTED=true git_merge_ffonly_ssh_mirror "$@"
  fi

echoInstallHelp = echoInstallHelp 'os_linux' 'dxy_all'

isInstalled = command -v alacritty > /dev/null

# ALTLY:
#  isInstalled = ( unset -f alacritty && test "$(type -t alacritty)" = "file" )
isInstalled = ( unset -f alacritty && test -n "$(type -p alacritty)" )
install = install_os_specific
installDarwin =
  if [ ! -e "${HOMEBREW_PREFIX}/bin/alacritty" ]; then
    warn "Please install \`alacritty\` from Homebrew"
    #
    return 1
  fi
  # LOPRI/2025-01-14 18:16: Try this on macOS:
  #
  # ALTLY:
  # https://github.com/alacritty/alacritty/blob/master/INSTALL.md#macos
  make app
  command cp -r target/release/osx/Alacritty.app /Applications/
  # The following will build an executable that runs on both x86
  # and ARM macos architectures:
  #  rustup target add x86_64-apple-darwin aarch64-apple-darwin
  #  make app-universal
installLinux =
  if [ -f "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
  fi
  if ! command -v rustup > /dev/null; then
    >&2 echo "ERROR: Please install rustup.rs:"
    >&2 echo "  mr -d ${MOSREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/rust}/rustup.rs -n checkout"
    >&2 echo "  mr -d ${MOSREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/rust}/rustup.rs -n install"
    #
    return 1
  fi
  #
  sudo -v -p "for the sudo: "
  #
  # REFER:
  # https://github.com/alacritty/alacritty/blob/master/INSTALL.md#dependencies
  sudo apt update
  sudo apt install -y \
    cmake \
    g++ \
    pkg-config \
    libfreetype6-dev \
    libfontconfig1-dev \
    libxcb-xfixes0-dev \
    libxkbcommon-dev \
    python3
  # "If you're running Wayland with an Nvidia GPU, you'll likely want
  #  the EGL drivers installed too."
  sudo apt install libegl1-mesa-dev
  #
  #
  pull_latest "starter" "master" "" "main"
  #
  # "To make sure you have the right Rust compiler installed, run"
  rustup override set stable
  rustup update stable  
  #
  # Create: target/release/alacritty
  cargo build --release
  # ALTLY:
  # # Force support for only Wayland
  # cargo build --release --no-default-features --features=wayland
  # # Force support for only X11
  # cargo build --release --no-default-features --features=x11
  #
  # Verify alacritty or alacritty-direct terminfo,
  # - SAVVY: Was pre-installed on Debian 12.
  if ! infocmp alacritty > /dev/null 2>&1; then
    sudo tic -xe alacritty,alacritty-direct extra/alacritty.info
  fi
  #
  # "Install the desktop entry for Alacritty".
  # - REFER: "Prerendered PNGs and simplified SVGs" in: extra/logo/compat
  sudo cp target/release/alacritty /usr/local/bin # or anywhere else in $PATH
  sudo cp extra/logo/alacritty-term.svg /usr/share/pixmaps/Alacritty.svg
  sudo desktop-file-install extra/linux/Alacritty.desktop
  sudo update-desktop-database
  #
  # "Installing the manual page."
  sudo apt install -y gzip scdoc
  sudo mkdir -p /usr/local/share/man/man1
  sudo mkdir -p /usr/local/share/man/man5
  scdoc < extra/man/alacritty.1.scd | gzip -c \
    | sudo tee /usr/local/share/man/man1/alacritty.1.gz > /dev/null
  scdoc < extra/man/alacritty-msg.1.scd | gzip -c \
    | sudo tee /usr/local/share/man/man1/alacritty-msg.1.gz > /dev/null
  scdoc < extra/man/alacritty.5.scd | gzip -c \
    | sudo tee /usr/local/share/man/man5/alacritty.5.gz > /dev/null
  scdoc < extra/man/alacritty-bindings.5.scd | gzip -c \
    | sudo tee /usr/local/share/man/man5/alacritty-bindings.5.gz > /dev/null
  #
  # Wire Alacritty completions
  append_bash_completion ". ${MR_REPO}/extra/completions/alacritty.bash"

