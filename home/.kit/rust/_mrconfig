# https://rustup.rs/
# https://www.rust-lang.org/tools/install
[${MOSREPOSPATH:-${DOPP_KIT:-${HOME}/.kit}/rust}/rustup.rs]
checkout = stub_checkout_directory
# Not an actual repo
skip = no_travel
ffssh = OMR_TRAVEL_BLOCKLISTED=true git_merge_ffonly_ssh_mirror "$@"

echoInstallHelp = echoInstallHelp 'os_all' 'dxy_all'

isInstalled = ( unset -f rustup && . "$HOME/.cargo/env" && test -n "$(type -p rustup)" ) 2> /dev/null

# CXREF: ~/.kit/sh/home-fries/lib/distro/default-browser.sh
# isInstalled =
#   test "se.johnste.finicky" = \
#     "$(/usr/bin/env bash "${HOME}/.kit/sh/home-fries/lib/distro/default-browser.sh")"
install = install_os_specific
installLinux =
  cd "${MR_REPO}"  # Already there, just FYI
  wget https://sh.rustup.rs -O install-rust.sh
  chmod 775 install-rust.sh
  ./install-rust.sh -y
  # Remove final line Rust install added to ~/.bashrc and ~/.profile:
  #   . "$HOME/.cargo/env"
  for rc_file in "${HOME}/.bashrc" "${HOME}/.profile" "${HOME}/.zshenv"; do
    canon_file="$(realpath -- "${rc_file}")"
    if [ "$(tail -n2 "${canon_file}")" = "$(echo; echo '. "$HOME/.cargo/env"')" ]; then
      info "Removing rustup-added cargo-load from file: ${rc_file}"
      gnu_sed () {
        for cmd in "gsed" "sed"; do
          ( unset -f ${cmd}; unalias ${cmd}; command -v ${cmd} ) 2> /dev/null \
            && break
        done
      }
      $(gnu_sed) -i '$ d' "${canon_file}"
    fi
  done
  # Or if you didn't already have one of these files.
  for rc_file in "${HOME}/.bashrc" "${HOME}/.profile" "${HOME}/.zshenv"; do
    if [ $(cat "${rc_file}" | wc -l) -eq 1 ]; then
      if [ "$(cat "${rc_file}")" = '. "$HOME/.cargo/env"' ]; then
        info "Removing rustup-created cargo-load file: ${rc_file}"
        command rm -- "${rc_file}"
      fi
    fi
  done

