[${SHOILERPLATE:-${HOME}/.kit/sh}/sh-ask-yesnoskip]
lib = remote_set publish https://github.com/landonb/sh-ask-yesnoskip.git

# CXREF: link_hard_dep_sh_colors
[${SHOILERPLATE:-${HOME}/.kit/sh}/sh-colors]
