  # CXREF: ~/.kit/git/git-update-faithful/lib/update-faithful.sh
  #
  update_faithful_finish_signed () {
    local sourcerer="https://github.com/DepoXy/depoxy/blob/release/home/.kit/mOS/_mrconfig"
    #
    update_faithful_finish \
      "${sourcerer}" \
      "${_skip_venv_manage:-false}" \
      "${_commit_subject}" \
      "${_source_project:-Homebrew/install}"
  }
  #
  update_deps_homebrew_install_sh () {
    [ -f "deps/Homebrew/install/install.sh" ] || return 0
    #
    export UPDEPS_CANON_BASE_ABSOLUTE="${DOPP_KIT:-${HOME}/.kit}/odd/homebrew/install"
    #
    update_faithful_file \
      "deps/Homebrew/install/install.sh" \
      "install.sh"
    #
    update_faithful_finish_signed
  }
  #
  update_deps_homebrew_install_sh
  update_faithful_finish_signed

