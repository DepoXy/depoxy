[${DOPP_KIT:-${HOME}/.kit}/js/nvm]
lib = remote_set starter https://github.com/nvm-sh/nvm.git
# Bump the order so before projects that need nvm (like fzf, OpenLens).
order = 689
# Checkout the latest tagged release, so we're not running "unreleased" code.
echoInstallHelp =
  which_os="os_all"
  dxy_scope="dxy_all"
  #
  echoInstallHelp "${which_os}" "${dxy_scope}"
  #
  # DUNNO/2025-09-07: -Mq still leaks output, e.g.:
  # - stdout: mr isInstalledNVMNodes: /home/landonb/.kit/js/nvm
  # - stderr: mr isInstalledNVMNodes: command failed
  is_installed=$(
    mr -Mq -d "${MR_REPO}" -n isInstalledNVMNodes >/dev/null 2>&1 &&
      echo "true" || echo "false"
  )
  local checkbox="$(echoInstallHelpWidget "${which_os}" "${dxy_scope}" ${is_installed})"
  echo "${checkbox} DepoXy [${MR_ORDER}]: Install latest supported Node versions::
    mr -d \"${MR_REPO}\" -n installNVMNodes
 "
   #
  is_installed=$(
    mr -Mq -d "${MR_REPO}" -n isInstalledNPMPackages >/dev/null 2>&1 &&
      echo "true" || echo "false"
  )
  local checkbox="$(echoInstallHelpWidget "${which_os}" "${dxy_scope}" ${is_installed})"
  echo "${checkbox} DepoXy [${MR_ORDER}]: Install select npm packages into latest Node::
    mr -d \"${MR_REPO}\" -n installNPMPackages
 "
isInstalled =
  # CXREF: Wired on shell startup using repo assets:
  #   ~/.depoxy/ambers/core/nvm-setup.sh
  # - Aka, there's nothing to install, just a script to source.
  . "${MR_REPO}/nvm.sh"
  # "nvm is a shell function"
  type nvm
  test "$(command -v nvm)" = "nvm"
install =
  pull_latest "starter" "master" "" "main"
  #
  mr -d "${MR_REPO}" -n installNVMNodes
  #
  # ISOFF/2023-04-25: I think ./install.sh is unnecessary.
  # - Homefries Bashrc sources nvm from repo location, which should be
  #   equivalent (./install.sh downloads sources and probably wires to
  #   shell; which is what the local repo and Homefries Bashrc accomplish).
  # - If we called ./install.sh, then pinning branch would not matter,
  #   because ./install.sh downloads files.
  #  ./install.sh

# USYNC: nvm_versions
isInstalledNVMNodes =
  . "${MR_REPO}/nvm.sh"
  # These print "N/A" and return nonzero unless that version installed.
  # And we can probe just the major version, no need to specify minor
  # or patch.
  nvm version 20
  nvm version 22
  nvm version 24
# Install current and active/maintenance Node versions.
# - TIMED: Very fast!
# - CXREF/2024-04-09: USYNC:
#   https://nodejs.org/en/about/previous-releases
installNVMNodes =
  # USYNC: nvm_versions
  for node_ver in \
    20.19.5 \
    22.19.0 \
    24.7.0 \
  ; do
    echo
    echo "Installing Node v${node_ver}..."
    echo
    . "${MR_REPO}/nvm.sh"
    nvm install "v${node_ver}"
  done

isInstalledNPMPackages =
  . "${MR_REPO}/nvm.sh"
  nvm use node > /dev/null
  # USYNC: installNPMPackages, isInstalledNPMPackages, nvm-setup.sh.
  (unset -f svgo && command -v svgo)
  (unset -f claude && command -v claude)
  (unset -f amp && command -v amp)
# CXREF: Otherwise installed lazily:
#   ~/.depoxy/ambers/core/nvm-setup.sh
installNPMPackages =
  nvm use node > /dev/null
  # USYNC: installNPMPackages, isInstalledNPMPackages, nvm-setup.sh.
  npm install -g svgo
  npm install -g @anthropic-ai/claude-code
  npm install -g @sourcegraph/amp

